###############################################################################
## Bazel Configuration Flags
##
## `.bazelrc` is a Bazel configuration file.
## https://bazel.build/docs/best-practices#bazelrc-file
###############################################################################

###############################################################################
## Build configuration
###############################################################################

# Don't create bazel-* symlinks in the project root directory.
# Instead, set a prefix and put it in .gitignore
build --symlink_prefix=target-bzl/

###############################################################################
## Test configuration
###############################################################################

# Reduce test output to just error cases and report failures verbose.
test --test_output=errors
test --verbose_failures

###############################################################################
## Rust configuration
###############################################################################

# Enable pipelined build
common --@rules_rust//rust/settings:pipelined_compilation=true

###############################################################################
## Common configuration
###############################################################################

# Write build outputs in a platform-specific directory;
# avoid outputs being wiped and rewritten when switching between platforms.
common --experimental_platform_in_output_dir

# Enable misc. performance optimizations.
# https://www.buildbuddy.io/blog/debugging-slow-bazel-builds/
# https://www.buildbuddy.io/blog/how-bazel-7-0-makes-your-builds-faster/
common --nolegacy_important_outputs
common --verbose_failures
common --noexperimental_merged_skyframe_analysis_execution
common --reuse_sandbox_directories

# Enable a more detailed performance profile
# common --noslim_profile
# common --experimental_profile_include_target_label
# common --experimental_profile_include_primary_output

###############################################################################
## Cross compilation configuration
###############################################################################

# Debug toolchain resolution
# build --toolchain_resolution_debug='@bazel_tools//tools/cpp:toolchain_type

# Required to resolve C/C++ toolchain.
# https://github.com/bazel-contrib/musl-toolchain?tab=readme-ov-file#setup
build --incompatible_enable_cc_toolchain_resolution

# Required to support cross compilation from different host systems i.e Mac and Linux
# https://bazel.build/reference/command-line-reference#flag--enable_platform_specific_config
common --enable_platform_specific_config

# Build targets for different hosts
build:macos --extra_execution_platforms=//bazel/platforms:darwin-aarch64
build:linux --extra_execution_platforms=//bazel/platforms:linux-x86_64

###############################################################################
## Remote configuration
###############################################################################

# Flags shared across remote configs
common:remote-shared --jobs=50
common:remote-shared --remote_timeout=10m
common:remote-shared --remote_cache_compression
common:remote-shared --verbose_failures
# Avoid inflating blobs smaller than 100 bytes with ZSTD compression.
common:remote-shared --experimental_remote_cache_compression_threshold=100
# Enable remote cache chunking
common:remote-shared --experimental_remote_cache_chunking
# common:remote-shared --remote_download_minimal

# Metadata. Only what is true of every remote invocation belongs here; ROLE and
# USER are set by the :ci config so BuildBuddy can tell CI runs from local ones.
common:remote-shared --build_metadata=REPO_URL=https://github.com/deepcausality-rs/deep_causality.git

# Remote execution platform.
#
# This host is an arm64 Mac and the RBE workers are x86_64 Linux, so the
# execution platform has to be pinned away from the host. --host_platform is
# the one that matters most: it sets the platform for exec-configuration
# actions (build tools such as rules_rust's process_wrapper). Left at the
# auto-detected darwin host, Bazel picks the aarch64-apple-darwin rustc and
# then ships it to a Linux worker, which fails as
# `rustc: Syntax error: ")" unexpected`.
#
# The platform inherits @llvm//platforms:linux_x86_64, so it carries the libc
# and cxxstdlib constraints the hermetic LLVM cc_toolchain resolves on.
common:remote-shared --host_platform=//bazel/platforms:linux_x86_64_remote
common:remote-shared --platforms=//bazel/platforms:linux_x86_64_remote
common:remote-shared --extra_execution_platforms=//bazel/platforms:linux_x86_64_remote

# Endpoints. The org subdomain serves BES, CAS and execution alike.
common:remote-shared --bes_results_url=https://deepcausality-rs.buildbuddy.io/invocation/
common:remote-shared --bes_backend=grpcs://deepcausality-rs.buildbuddy.io
common:remote-shared --remote_cache=grpcs://deepcausality-rs.buildbuddy.io
common:remote-shared --remote_executor=grpcs://deepcausality-rs.buildbuddy.io

# Build with --config=remote to enable Remote Build Execution (RBE)
common:remote --config=remote-shared
common:remote --build_metadata=USER=remote

# Build with --config=ci specifically for CI runs. Same execution setup as
# --config=remote, tagged so the BuildBuddy dashboard can separate CI runs from
# developer machines.
common:ci --config=remote-shared
common:ci --build_metadata=ROLE=CI
common:ci --build_metadata=USER=gh
common:ci --build_metadata=VISIBILITY=PUBLIC

###############################################################################
## Custom user or remote flags
##
## This should always be the last thing in the `.bazelrc` beccause
# `.bazelrc` files are evaluated top to bottom.
###############################################################################
try-import %workspace%/user.bazelrc

try-import %workspace%/.bazelrc.remote