load("@crates//:defs.bzl", "aliases", "all_crate_deps", "lint_config")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rust//rust:defs.bzl", "rust_doc", "rust_doc_test", "rust_test_suite")

rust_library(
    name = "deep_causality_algorithms",
    srcs = glob([
        "src/**",
    ]),
    aliases = aliases(),
    crate_root = "src/lib.rs",
    lint_config = lint_config(),
    tags = [
        "data_structures",
    ],
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)

rust_doc(
    name = "doc",
    crate = ":deep_causality_algorithms",
    tags = ["doc"],
    visibility = ["//visibility:public"],
)

rust_doc_test(
    name = "doc_test",
    crate = ":deep_causality_algorithms",
    tags = ["doc-test"],
    visibility = ["//visibility:public"],
)

# Example binaries (Cargo `[[example]]` targets).

# Self-contained: it carries its own graph type and its own transcription of the Meek rules, so
# that it can judge the library's closure rather than agree with it. It therefore depends on the
# crate only for the Cargo/Bazel parity the repository requires, not for any of its own logic.
rust_binary(
    name = "verification_meek_r4",
    srcs = [
        "verification/brcd/verification_meek_r4.rs",
    ],
    crate_root = "verification/brcd/verification_meek_r4.rs",
    visibility = ["//visibility:public"],
    deps = [
        ":deep_causality_algorithms",
    ] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

rust_binary(
    name = "verification_base",
