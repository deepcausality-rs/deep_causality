# The crate's own in-src `#[cfg(test)]` modules — `surd_utils_tests` and `mrmr_utils_tests`.
#
# They exercise `pub(crate)` helpers that the `tests/` tree cannot reach, so they cannot be moved
# there without widening the public API purely for testing. Without this target they run under
# `cargo test` and **not** under `bazel test //...`, which is the command this repository treats as
# authoritative — 27 tests that the canonical run never executed (`unified-math-next` task 5.19).
rust_test(
    name = "lib_unit_tests",
    crate = ":deep_causality_algorithms",
    crate_features = [
        "default",
    ],
    tags = [
        "unit-test",
    ],
    visibility = ["//visibility:public"],
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
