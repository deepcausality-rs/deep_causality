load("@crates//:defs.bzl", "aliases", "all_crate_deps", "lint_config")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@rules_rust//rust:defs.bzl", "rust_doc", "rust_doc_test", "rust_test_suite")

rust_library(
    name = "deep_causality_data_structures",
    srcs = glob([
        "src/**",
    ]),
    aliases = aliases(),
    crate_features = [
        "alloc",
        "std",
    ],
    crate_root = "src/lib.rs",
    lint_config = lint_config(),
    tags = [
        "data_structures",
    ],
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)

rust_doc(
    name = "doc",
    crate = ":deep_causality_data_structures",
    crate_features = [
        "alloc",
        "std",
    ],
    tags = ["doc"],
    visibility = ["//visibility:public"],
)

rust_doc_test(
    name = "doc_test",
    crate = ":deep_causality_data_structures",
    crate_features = [
        "alloc",
        "std",
    ],
    tags = ["doc-test"],
    visibility = ["//visibility:public"],
)

# Example binaries (Cargo `[[example]]` targets).

rust_binary(
    name = "array_grid",
    srcs = ["examples/array_grid/array_grid.rs"],
    crate_root = "examples/array_grid/array_grid.rs",
    visibility = ["//visibility:public"],
    deps = [
        ":deep_causality_data_structures",
    ] + all_crate_deps(
        normal = True,
        # Cargo `[[example]]` targets link dev-dependencies.
        normal_dev = True,
    ),
)

rust_binary(
    name = "window_type_array_storage",
    srcs = ["examples/window_type/array_storage.rs"],
    crate_root = "examples/window_type/array_storage.rs",
    visibility = ["//visibility:public"],
    deps = [
        ":deep_causality_data_structures",
    ] + all_crate_deps(
        normal = True,
        # Cargo `[[example]]` targets link dev-dependencies.
        normal_dev = True,
    ),
)

rust_binary(
    name = "window_type_vector_storage",
    srcs = ["examples/window_type/vector_storage.rs"],
    crate_root = "examples/window_type/vector_storage.rs",
    visibility = ["//visibility:public"],
    deps = [
        ":deep_causality_data_structures",
    ] + all_crate_deps(
        normal = True,
        # Cargo `[[example]]` targets link dev-dependencies.
        normal_dev = True,
    ),
)

rust_test_suite(
    name = "grid_type_tests",
    srcs = glob([
        "tests/grid_type/*_tests.rs",
    ]),
    tags = [
        "unit-test",
    ],
    visibility = ["//visibility:public"],
    deps = [
        # Crate to test
        ":deep_causality_data_structures",
    ] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

rust_test_suite(
    name = "window_type_safe_tests",
    srcs = glob([
        "tests/window_type/storage_safe/*_tests.rs",
    ]),
    tags = [
        "unit-test",
    ],
    visibility = ["//visibility:public"],
    deps = [
        # Crate to test
        ":deep_causality_data_structures",
    ] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

# The crate's own in-src `#[cfg(test)]` modules.
#
# They exercise private and `pub(crate)` items that the `tests/` tree cannot reach, so they stay
# where they are; without this target they run under `cargo test` and **not** under
# `bazel test //...`, which is the command this repository treats as authoritative
# (`unified-math-next` task 5.19).
rust_test(
    name = "lib_unit_tests",
    crate = ":deep_causality_data_structures",
    crate_features = [
        "alloc",
        "std",
    ],
    tags = [
        "unit-test",
    ],
    visibility = ["//visibility:public"],
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
