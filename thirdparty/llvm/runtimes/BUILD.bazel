)

cc_stage0_object(
    name = "crtn_object",
    srcs = [
        ":empty",
    ],
    out = "crtn.o",
    copts = [
        "-target",
    ] + LLVM_TARGET_TRIPLE,
    visibility = ["//visibility:public"],
)

