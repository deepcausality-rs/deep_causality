            "//runtimes/musl:musl_Scrt1.object",
        ],
        "//platforms/config:gnu": [
            "//runtimes/glibc:glibc_Scrt1.object",
            "//runtimes/glibc:glibc_crt1.object",
        ],
    }) + [
        ":crti_object",
        ":crtn_object",
        "@llvm-project//compiler-rt:crtbeginS_object",
        "@llvm-project//compiler-rt:crtbeginT_object",
        "@llvm-project//compiler-rt:crtbegin_object",
        "@llvm-project//compiler-rt:crtendS_object",
        "@llvm-project//compiler-rt:crtend_object",
