# macOS + a target sanitizer flag. Using <san>_target_config (the exec-forced
# wrapper) keeps host tools out even when the sanitizer flag is set globally.
config_setting(
    name = "_asan_dynamic_runtime_macos",
    constraint_values = ["@platforms//os:macos"],
    flag_values = {"//config:asan_target_config": "true"},
)

config_setting(
    name = "_ubsan_dynamic_runtime_macos",
    constraint_values = ["@platforms//os:macos"],
    flag_values = {"//config:ubsan_target_config": "true"},
)

config_setting(
    name = "_lsan_dynamic_runtime_macos",
    constraint_values = ["@platforms//os:macos"],
    flag_values = {"//config:lsan_target_config": "true"},
)

config_setting(
    name = "_tsan_dynamic_runtime_macos",
    constraint_values = ["@platforms//os:macos"],
    flag_values = {"//config:tsan_target_config": "true"},
)

# On Darwin the sanitizer runtimes are dylibs. Adding an enabled sanitizer's
# dylib to the dynamic runtime libs makes the toolchain place it in the runfiles
# of any dynamically-linked target and emit the @loader_path rpath (via the
# runtime_library_search_directories feature), so it loads at run time without a
# per-target dynamic_deps. This covers cc_test (and other dynamically-linked
# rules); statically-linked cc_binary targets still add it via dynamic_deps.
# Linux links the static runtimes, so nothing is added there; the .shared
# targets are Darwin-only, hence the macOS gate.
filegroup(
    name = "dynamic_runtime_lib",
    srcs = ["//runtimes/cxxstdlib:dynamic_runtime_lib"] + select({
        ":_asan_dynamic_runtime_macos": ["//runtimes/compiler-rt:clang_rt.asan.shared"],
        "//conditions:default": [],
    }) + select({
        ":_ubsan_dynamic_runtime_macos": ["//runtimes/compiler-rt:clang_rt.ubsan_standalone.shared"],
        "//conditions:default": [],
    }) + select({
        ":_lsan_dynamic_runtime_macos": ["//runtimes/compiler-rt:clang_rt.lsan.shared"],
        "//conditions:default": [],
    }) + select({
        ":_tsan_dynamic_runtime_macos": ["//runtimes/compiler-rt:clang_rt.tsan.shared"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
)

cc_library(
    name = "empty",
    srcs = ["empty.c"],
    copts = ["-fno-addrsig"],
)

cc_stage0_object(
    name = "crti_object",
    srcs = [
