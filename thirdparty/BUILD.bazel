load("@rules_rust//crate_universe:defs.bzl", "crate", "crates_vendor")

crates_vendor(
    name = "crates_vendor",
    annotations = {},
    mode = "local",
    packages = {
        #
        # Proc macros dependencies
        "rusty-fork": crate.spec(
            default_features = True,
            package = "rusty-fork",
            version = "0.3",
        ),
        #
        # Regular dependencies
        "chrono": crate.spec(
            default_features = False,
            package = "chrono",
            version = "0.4",
        ),
        "csv": crate.spec(
            default_features = False,
            package = "csv",
            version = "1.4",
        ),
        # Already present transitively; declared here so `//thirdparty/crates:getrandom`
        # exists as a top-level alias for `deep_causality_rand`'s `os-random` feature.
        "getrandom": crate.spec(
            default_features = True,
            package = "getrandom",
            version = "0.4",
        ),
        "parquet": crate.spec(
            default_features = False,
            package = "parquet",
            version = "59",
        ),
        "libm": crate.spec(
            default_features = True,
            package = "libm",
            version = "0.2",
        ),
        "tempfile": crate.spec(
            default_features = False,
            package = "tempfile",
            version = "3",
        ),
        "tokio": crate.spec(
            default_features = True,
            features = ["full"],
            package = "tokio",
            version = "1",
        ),
    },  # End packages
    repository_name = "deep_causality_vendored",
    tags = ["manual"],
)
