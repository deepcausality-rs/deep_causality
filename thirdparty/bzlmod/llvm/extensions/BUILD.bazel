load("@bazel_lib//:bzl_library.bzl", "bzl_library")

bzl_library(
    name = "gcc",
    srcs = ["gcc.bzl"],
    visibility = ["//visibility:public"],
    deps = ["//3rd_party/gcc/extension:gcc"],
)

bzl_library(
    name = "llvm",
    srcs = ["llvm.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        "//private:llvm_project_archive",
        "//private:llvm_project_from_git",
        "//private:llvm_project_from_path",
        "@bazel_skylib//lib:structs",
        "@bazel_tools//tools/build_defs/repo:http.bzl",
    ],
)

bzl_library(
    name = "llvm_toolchain_minimal",
    srcs = ["llvm_toolchain_minimal.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        "@bazel_features//:features",
        "@bazel_tools//tools/build_defs/repo:cache.bzl",
        "@bazel_tools//tools/build_defs/repo:http.bzl",
        "@bazel_tools//tools/build_defs/repo:utils.bzl",
        "@llvm_version//:version",
    ],
)

bzl_library(
    name = "osx",
    srcs = ["osx.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        "//:http_bsdtar_archive",
        "//:http_pkg_archive",
        "@bazel_features//:features",
    ],
)

bzl_library(
    name = "toolchain",
    srcs = ["toolchain.bzl"],
    visibility = ["//visibility:public"],
    deps = ["//platforms:common"],
)
