load("@crates//:defs.bzl", "aliases", "all_crate_deps", "lint_config")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rust//rust:defs.bzl", "rust_doc", "rust_doc_test", "rust_test_suite")

rust_library(
    name = "deep_causality_quantum",
    srcs = glob([
        "src/**",
    ]),
    aliases = aliases(),
    # The Bazel build enables the emergent `qpu` seam so the whole crate is
    # compiled and tested; the default *cargo* build stays verifiable-only
    # (`default = []`), which is the modality guarantee the spec states.
    crate_features = [
        "qcm",
        "qpu",
    ],
    crate_root = "src/lib.rs",
    lint_config = lint_config(),
    tags = [
        "quantum",
    ],
    visibility = ["//visibility:public"],
    deps = [
        # NOT all_crate_deps: this crate's Cargo `default` set is empty, and all_crate_deps
        # resolves optional dependencies against the DEFAULT features. `qcm` and `qpu` (enabled
        # in crate_features above) gate `deep_causality` and `deep_causality_uncertain`, which
        # all_crate_deps then declares as edges without emitting `--extern` for them, so the
        # crate fails to compile. Re-listing them alongside all_crate_deps is rejected as a
        # duplicate label, so the full list is written out here.
        "//deep_causality",
        "//deep_causality_core",
        "//deep_causality_unified_math/deep_causality_algebra",
        "//deep_causality_unified_math/deep_causality_haft",
        "//deep_causality_unified_math/deep_causality_homology",
        "//deep_causality_unified_math/deep_causality_linear",
        "//deep_causality_unified_math/deep_causality_metric",
        "//deep_causality_unified_math/deep_causality_multivector",
        "//deep_causality_unified_math/deep_causality_num",
        "//deep_causality_unified_math/deep_causality_num_complex",
        "//deep_causality_unified_math/deep_causality_num_rational",
        "//deep_causality_unified_math/deep_causality_tensor",
        "//deep_causality_unified_math/deep_causality_uncertain",
    ],
)

rust_doc(
    name = "doc",
    crate = ":deep_causality_quantum",
    crate_features = [
        "qcm",
        "qpu",
    ],
    tags = ["doc"],
    visibility = ["//visibility:public"],
)

rust_doc_test(
    name = "doc_test",
    crate = ":deep_causality_quantum",
    crate_features = [
        "qcm",
        "qpu",
    ],
    tags = ["doc-test"],
    visibility = ["//visibility:public"],
)

