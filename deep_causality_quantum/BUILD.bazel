load("@crates//:defs.bzl", "aliases", "all_crate_deps", "lint_config")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rust//rust:defs.bzl", "rust_doc", "rust_doc_test", "rust_test_suite")

rust_library(
    name = "deep_causality_quantum",
    srcs = glob([
        "src/**",
    ]),
    aliases = aliases(),
    # Sets the qpu feature. Howver, optional deps have to decalred under all_crate_deps below
    crate_features = [
        "alloc",
        "dem",
        "qcm",
        "qpu",
        "std",
    ],
    crate_root = "src/lib.rs",
    lint_config = lint_config(),
    tags = [
        "quantum",
    ],
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True) + [
        # enables `deep_causality_quantum/qpu`
        "//deep_causality_unified_math/deep_causality_uncertain",
    ],
)

# Example binaries (Cargo `[[example]]` targets).

# The sensing verifications: each reproduces a published claim through QCL. V1, V3, V4, V5 and V10
# read the digitised and regenerated data under `papers/` through `common/data.rs`, which resolves
# the crate's directory from `BUILD_WORKSPACE_DIRECTORY` under `bazel run`.
SENSING_DEPS = [
    ":deep_causality_quantum",
    "//deep_causality_context_store",
    "//deep_causality_unified_math/deep_causality_num_complex",
    "//deep_causality_unified_math/deep_causality_tensor",
]

rust_binary(
    name = "verification_v1_wavefront",
    srcs = [
        "verification/sensing/common/attribution.rs",
        "verification/sensing/common/data.rs",
        "verification/sensing/common/fringe_qubit.rs",
        "verification/sensing/common/report.rs",
        "verification/sensing/verification_v1_wavefront.rs",
    ],
    crate_root = "verification/sensing/verification_v1_wavefront.rs",
    visibility = ["//visibility:public"],
    deps = SENSING_DEPS + [
        "//deep_causality_unified_math/deep_causality_haft",
        "//deep_causality_unified_math/deep_causality_linear",
    ],
)

