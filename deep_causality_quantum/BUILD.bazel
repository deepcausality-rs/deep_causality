load("@crates//:defs.bzl", "aliases", "all_crate_deps", "lint_config")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rust//rust:defs.bzl", "rust_doc", "rust_doc_test", "rust_test_suite")

rust_library(
    name = "deep_causality_quantum",
    srcs = glob([
        "src/**",
    ]),
    aliases = aliases(),
    # Sets the qpu feature. Howver, optional deps have to decalred under all_crate_deps below
    crate_features = [
        "alloc",
        "qcm",
        "qpu",
        "std",
    ],
    crate_root = "src/lib.rs",
    lint_config = lint_config(),
    tags = [
        "quantum",
    ],
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True) + [
        # enables `deep_causality_quantum/qpu`
        "//deep_causality_unified_math/deep_causality_uncertain",
    ],
)

rust_doc(
    name = "doc",
    crate = ":deep_causality_quantum",
    crate_features = [
        "alloc",
        "qcm",
        "qpu",
        "std",
    ],
    tags = ["doc"],
    visibility = ["//visibility:public"],
)

rust_doc_test(
    name = "doc_test",
    crate = ":deep_causality_quantum",
    crate_features = [
        "alloc",
        "qcm",
        "qpu",
        "std",
    ],
    tags = ["doc-test"],
    visibility = ["//visibility:public"],
)

# =============================================================================
# error/* test suites
#
# The src tree is organized as src/error/, so the tests mirror it
# at tests/error/.
# =============================================================================

rust_test_suite(
    name = "error",
    srcs = glob([
        "tests/error/*_tests.rs",
    ]),
    tags = [
        "unit-test",
    ],
    visibility = ["//visibility:public"],
    deps = [
        # Crate to test
        ":deep_causality_quantum",
    ] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

