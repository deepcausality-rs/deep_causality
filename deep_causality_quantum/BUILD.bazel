# error/* test suites
#
# The src tree is organized as src/error/, so the tests mirror it
# at tests/error/.
# =============================================================================

rust_test_suite(
    name = "error",
    srcs = glob([
        "tests/error/*_tests.rs",
    ]),
    tags = [
        "unit-test",
    ],
    visibility = ["//visibility:public"],
    deps = [
        # Crate to test
        ":deep_causality_quantum",
    ] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

