module(name = "deep_causality")

###############################################################################
# Bazel Dependencies
# https://registry.bazel.build/
###############################################################################
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "toolchains_buildbuddy", version = "0.0.4")
bazel_dep(name = "llvm", version = "0.8.19")
bazel_dep(name = "rules_rs", version = "0.0.108")

# Pinned by commit until the module is published to the
# Bazel Central Registry; at that point this becomes a plain bazel_dep
bazel_dep(name = "rules_lean", version = "0.1.0")
git_override(
    module_name = "rules_lean",
    commit = "3f6c35f617fa750168b34c1a2a76e769d1142993",
    remote = "https://github.com/bazelverse/rules_lean.git",
)

###############################################################################
# rules_rs for Rust
# https://github.com/hermeticbuild/rules_rs
###############################################################################
rules_rs_rules_rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
use_repo(rules_rs_rules_rust, "rules_rust")

RUST_EDITION = "2024"

RUST_VERSION = "1.98.0"

toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
toolchains.toolchain(
    edition = RUST_EDITION,
    # Silences one clang driver diagnostic on every macOS link:
    #   clang++: argument unused during compilation: '-rtlib=compiler-rt'
    extra_rustc_flags = {
        "aarch64-apple-darwin": ["-Clink-arg=-Wno-unused-command-line-argument"],
        "x86_64-apple-darwin": ["-Clink-arg=-Wno-unused-command-line-argument"],
    },
    version = RUST_VERSION,
)
use_repo(toolchains, "default_rust_toolchains")

register_toolchains("@default_rust_toolchains//...")

# The triples for the RESOLVED dependency graph. rules_rs evaluates each crate's target-specific
# dependencies once per triple, so a `[target.'cfg(unix)'.dependencies]` entry is
# present in the graph whichever of these machines runs the build.
RUST_PLATFORMS = [
    "aarch64-apple-darwin",
    "aarch64-unknown-linux-gnu",
    "x86_64-unknown-linux-gnu",
]

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    generate_lint_config = True,
    platform_triples = RUST_PLATFORMS,
)
use_repo(crate, "crates")

###############################################################################
# Hermetic LLVM toolchain
# https://github.com/hermeticbuild/hermetic-llvm
###############################################################################
# The LLVM version is selected on the `llvm` extension.
llvm = use_extension("@llvm//extensions:llvm.bzl", "llvm")

# llvm_version matches the one Rust uses in the version declared in the previous step.
llvm.version(llvm_version = "22.1.8")
use_repo(llvm, "llvm-project")

# The macOS sysroot. The web.archive entry is a fallback in case the Apple URL returns 503.
osx = use_extension("@llvm//extensions:osx.bzl", "osx")
osx.from_archive(
    sha256 = "5f044578cd78a3a9b9c965a42d56bad609ee5d252e1d4e6aa7c42fc3f35fee7b",
    strip_prefix = "Payload/Library/Developer/CommandLineTools/SDKs/MacOSX26.5.sdk",
    type = "pkg",
    urls = [
        "https://swcdn.apple.com/content/downloads/09/08/047-91568-A_Y1CFZWQCD4/4xekpyz43i26dbp4enxfro8eb1q7wiujh5/CLTools_macOSNMOS_SDK.pkg",
        "https://web.archive.org/web/20260512015547id_/https://swcdn.apple.com/content/downloads/09/08/047-91568-A_Y1CFZWQCD4/4xekpyz43i26dbp4enxfro8eb1q7wiujh5/CLTools_macOSNMOS_SDK.pkg",
    ],
)
osx.frameworks(names = [
    "System",
    "CoreFoundation",
    "Foundation",
    "Kernel",
    "OSLog",
    "Security",
    "SystemConfiguration",
])

# `@llvm//toolchain:all`, not a per-exec-platform `@llvm_toolchains`: the repo
# declares one cc toolchain per (exec, target) pair, each carrying its own
# constraints, so Bazel selects by platform.
register_toolchains("@llvm//toolchain:all")

# --- RBE Toolchain and platforms  ----------------------------------
# The remote platform (`linux_x86_64_remote`) is not registered here: .bazelrc sets it.
register_execution_platforms(
    "//bazel/platforms:linux-x86_64",
    "//bazel/platforms:linux-aarch64",
)

###############################################################################
# BuildBuddy Rules for Remote build
# https://github.com/buildbuddy-io/buildbuddy-toolchain
###############################################################################
buildbuddy = use_extension("@toolchains_buildbuddy//:extensions.bzl", "buildbuddy")
use_repo(buildbuddy, "buildbuddy_toolchain")

###############################################################################
# Lean 4 toolchain + Lake/Mathlib workspace
# https://github.com/marvin-hansen/rules_lean  (pinned by commit above)
###############################################################################
#
# Lean 4 toolchain version is pinned in
# lean/lakefile.toml
# lean/lean-toolchain
# Both files are loaded via lean/BUILD.bazel
#
# Downloads the pinned Lean toolchain (lean/lean-toolchain) and resolves the
# Lake/Mathlib dependency graph (lean/lakefile.toml + lean/lake-manifest.json)
# into @lake_deps, pulling prebuilt Mathlib oleans from the Reservoir cache.
# `bazel build //lean/...` then type-checks every proof.
###############################################################################
lake = use_extension("@rules_lean//lean:lake.bzl", "lake")
lake.workspace(
    name = "lake_deps",
    # Tree-shake the Mathlib olean download to the modules the proofs import.
    # Regenerate after changing any import:
    #
    #   git ls-files 'lean/**/*.lean' | xargs grep -hoE '^import Mathlib[A-Za-z0-9_.]*' \
    #     | sed 's/^import //' | sort -u
    cache_roots = [
        "Mathlib.Algebra.Algebra.Basic",
        "Mathlib.Algebra.DualNumber",
        "Mathlib.Algebra.Field.Basic",
        "Mathlib.Algebra.Field.ZMod",
        "Mathlib.Algebra.Group.Basic",
        "Mathlib.Algebra.Group.Defs",
        "Mathlib.Algebra.Order.Group.Int",
        "Mathlib.Algebra.Order.Group.Unbundled.Int",
        "Mathlib.Algebra.Order.Ring.Defs",
        "Mathlib.Algebra.Quaternion",
        "Mathlib.Algebra.Ring.Basic",
        "Mathlib.Algebra.Star.Basic",
        "Mathlib.Analysis.Complex.Basic",
        "Mathlib.Analysis.Normed.Field.Basic",
        "Mathlib.Data.Rat.Cast.Defs",
        "Mathlib.Data.Real.Basic",
        "Mathlib.LinearAlgebra.Dimension.RankNullity",
        "Mathlib.LinearAlgebra.FiniteDimensional.Lemmas",
        "Mathlib.LinearAlgebra.Matrix.Rank",
        "Mathlib.LinearAlgebra.Matrix.ToLin",
        "Mathlib.LinearAlgebra.Matrix.Trace",
        "Mathlib.Tactic.Linarith",
    ],
    lake_manifest = "//lean:lake-manifest.json",
    lakefile = "//lean:lakefile.toml",
    lean_toolchain = "//lean:lean-toolchain",
    # Regenerate after touching lake-manifest.json or lean-toolchain:
    #   scripts/lean_lock.sh sources
    lock = "//lean:lake-lock.json",
)
use_repo(lake, "lake_deps", "lean_dist_4_32_0_toolchains")

# `//:all`, not a single target: the repo declares one toolchain per execution
# platform, each constrained by `exec_compatible_with`, so Bazel picks the binary that
# runs where the action runs. A single unconstrained declaration matched every
# platform and shipped this Mac's Lean to the Linux RBE workers -- `Exec format
# error`, at execution time, only under --config=remote.

register_toolchains("@lean_dist_4_32_0_toolchains//:all")
