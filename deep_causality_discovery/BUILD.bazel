load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_doc", "rust_doc_test", "rust_library")

rust_library(
    name = "deep_causality_discovery",
    srcs = glob([
        "src/**",
    ]),
    crate_root = "src/lib.rs",
    tags = [
        "data_structures",
    ],
    visibility = ["//visibility:public"],
    deps = [
        # Internal dependencies
        "//deep_causality_unified_math/deep_causality_tensor",
        "//deep_causality_unified_math/deep_causality_num",
        "//deep_causality_unified_math/deep_causality_algebra",
        "//deep_causality_algorithms",
        "//deep_causality_unified_math/deep_causality_haft",
        "//deep_causality_unified_math/deep_causality_topology",
        # External dependencies
        "//thirdparty/crates:csv",
        "//thirdparty/crates:parquet",
        "//thirdparty/crates:tempfile",
    ],
)

rust_doc(
    name = "doc",
    crate = ":deep_causality_discovery",
    tags = ["doc"],
    visibility = ["//visibility:public"],
)

rust_doc_test(
    name = "doc_test",
    crate = ":deep_causality_discovery",
    tags = ["doc-test"],
    visibility = ["//visibility:public"],
)

# Example binaries (Cargo `[[example]]` targets).

rust_binary(
    name = "brcd_cache_cold_vs_warm",
    srcs = ["examples/brcd_cache_cold_vs_warm.rs"],
    crate_root = "examples/brcd_cache_cold_vs_warm.rs",
    visibility = ["//visibility:public"],
    deps = [
        ":deep_causality_discovery",
        "//deep_causality_unified_math/deep_causality_rand",
    ],
)
