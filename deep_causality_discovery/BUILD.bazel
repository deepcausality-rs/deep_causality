load("@crates//:defs.bzl", "aliases", "all_crate_deps", "lint_config")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rust//rust:defs.bzl", "rust_doc", "rust_doc_test", "rust_test_suite")

rust_library(
    name = "deep_causality_discovery",
    srcs = glob([
        "src/**",
    ]),
    aliases = aliases(),
    crate_root = "src/lib.rs",
    lint_config = lint_config(),
    tags = [
        "data_structures",
    ],
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)

rust_doc(
    name = "doc",
    crate = ":deep_causality_discovery",
    tags = ["doc"],
    visibility = ["//visibility:public"],
)

rust_doc_test(
    name = "doc_test",
    crate = ":deep_causality_discovery",
    tags = ["doc-test"],
    visibility = ["//visibility:public"],
)

# Example binaries (Cargo `[[example]]` targets).

rust_binary(
    name = "brcd_cache_cold_vs_warm",
    srcs = ["examples/brcd_cache_cold_vs_warm.rs"],
    crate_root = "examples/brcd_cache_cold_vs_warm.rs",
    visibility = ["//visibility:public"],
    deps = [
        ":deep_causality_discovery",
    ] + all_crate_deps(
        normal = True,
        # Cargo `[[example]]` targets link dev-dependencies.
        normal_dev = True,
    ),
)

