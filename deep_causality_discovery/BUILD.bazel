    name = "errors",
    srcs = glob([
        "tests/errors/*_tests.rs",
    ]),
    tags = [
        "unit-test",
    ],
    visibility = ["//visibility:public"],
    deps = [
        # Crate to test
        ":deep_causality_discovery",
    ] + all_crate_deps(
        normal = True,
        normal_dev = True,
