---
/**
 * A tutorial video hosted on YouTube, loaded on click. Until a visitor presses play the figure is a
 * poster image linking to the video on YouTube, and the page makes no request to YouTube. A plain
 * click swaps the poster for YouTube's privacy-enhanced player (youtube-nocookie.com), which starts
 * playing; a modified click (new tab, new window) follows the link. Without JavaScript the link
 * opens the video on YouTube.
 *
 * - `id`: the YouTube video id.
 * - `title`: the video's title, for the caption and the player's accessible name.
 * - `poster`: a 1280 × 720 frame from the video, under `public/img/`.
 * - `length`: the running time as m:ss.
 */
interface Props {
  id: string;
  title: string;
  poster: string;
  length: string;
}

const { id, title, poster, length } = Astro.props;
const watch = `https://www.youtube.com/watch?v=${id}`;
---
<figure class="tutorial-video">
  <div class="tv-box">
    <a class="tv-frame" href={watch} data-tv-id={id} data-tv-title={title} aria-label={`Play the video: ${title} (${length}). Loads YouTube.`}>
      <img src={poster} alt="" width="1280" height="720" loading="lazy" decoding="async" />
      <svg class="tv-play" viewBox="0 0 72 72" aria-hidden="true">
        <circle cx="36" cy="36" r="34" />
        <path d="M29 23 L51 36 L29 49 Z" />
      </svg>
      <span class="tv-len" aria-hidden="true">{length}</span>
    </a>
  </div>
  <figcaption>
    <span class="tv-k">Video · {length}</span>
    <span class="tv-title">{title}</span>
    <span class="tv-note">Nothing loads from YouTube until you press play. <a href={watch}>Watch on YouTube</a></span>
  </figcaption>
</figure>

<script>
  // Click to load: replace the poster link with the privacy-enhanced player on a plain click.
  document.querySelectorAll<HTMLAnchorElement>('[data-tv-id]').forEach((link) => {
    link.addEventListener('click', (event) => {
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      const player = document.createElement('iframe');
      player.src = `https://www.youtube-nocookie.com/embed/${link.dataset.tvId}?autoplay=1&rel=0&playsinline=1`;
      player.title = link.dataset.tvTitle ?? 'Video';
      player.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      player.allowFullscreen = true;
      // YouTube refuses to play an embed that sends no referrer (its error 153).
      player.referrerPolicy = 'strict-origin-when-cross-origin';
      link.replaceWith(player);
      player.focus();
    });
  });
</script>

<style>
  .tutorial-video {
    margin: var(--space-6) 0;
  }
  .tv-box {
    position: relative;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--line-1);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--bg-1);
  }
  .tv-frame,
  .tv-box :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .tv-frame {
    display: block;
  }
  .tv-frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.85;
    transition: opacity var(--dur-med) var(--ease-out);
  }
  .tv-frame:hover img,
  .tv-frame:focus-visible img {
    opacity: 1;
  }
  .tv-play {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 72px;
    height: 72px;
    margin: -36px 0 0 -36px;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .tv-play circle {
    fill: color-mix(in srgb, var(--bg-0) 70%, transparent);
    stroke: var(--accent);
    stroke-width: 2;
  }
  .tv-play path {
    fill: var(--accent);
  }
  .tv-frame:hover .tv-play {
    transform: scale(1.06);
  }
  .tv-len {
    position: absolute;
    right: var(--space-3);
    bottom: var(--space-3);
    padding: 2px var(--space-2);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--bg-0) 80%, transparent);
    font-family: var(--font-mono);
    font-size: var(--t-mono-sm);
    color: var(--fg-0);
  }
  figcaption {
    display: grid;
    gap: var(--space-1);
    margin-top: var(--space-3);
    font-size: var(--t-body-sm);
    color: var(--fg-1);
  }
  .tv-k {
    font-family: var(--font-mono);
    font-size: var(--t-mono-sm);
    color: var(--accent);
  }
  .tv-title {
    color: var(--fg-0);
  }
</style>
