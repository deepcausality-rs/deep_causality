---
import { Code } from 'astro:components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/nav/SiteHeader.astro';
import TopicList from '../../components/overview/TopicList.astro';
import { DOCS_URL, GITHUB_URL } from '../../consts';

const themes = { light: 'github-light', dark: 'github-dark' } as const;

const balloon = `// model_config.rs: a regime detector compares the two mechanisms in the air measured now.
fn radiator_beats_fan(r: Reading) -> PropagatingEffect<bool> {
    let fan = fan_heat_w(air_density(r.pressure_kpa, r.air_c), COOL_ON_C, r.air_c);
    PropagatingEffect::pure(radiator_heat_w(COOL_ON_C, r.air_c) > REGIME_HYSTERESIS * fan)
}

// model_config.rs: a regime change replaces the two cooling states while the machine runs.
controller.update_single_state((
    state(COOL_ON, cell_needs_cooling),
    CausalAction::new(on, on_descr, version),
))?;
controller.update_single_state((
    state(COOL_OFF, cell_cool_enough),
    CausalAction::new(off, off_descr, version),
))?;

// main.rs, without the printing: once a minute, reason about the regime,
// then let every state act on the same reading.
while !flight.landed() {
    let reading = flight.reading();
    let next = model_config::next_regime(regime, &reading, &detectors)?;
    if next != regime {
        cooling_version += 1;
        model_config::install_cooling(&controller, next, cooling_version)?;
        regime = next;
    }
    let frame = PropagatingEffect::pure(reading);
    for id in STATES {
        controller.eval_single_state(id, &frame)?;
    }
    flight.step();
}`;

const balloonOut = `time         phase      alt km   air °C    sun cell °C  pack  cooling   heater charge (cell / budget)
day 1 10:00  morning       0.0     32.0    884    38.0   80%  fan       off    half (full / half)
day 1 10:03  morning       0.9     26.1    917    38.4   80%  fan       off    full (full / full)
day 1 10:35  morning      10.5    -36.2   1183    29.8   90%  off       off    full (full / full)
day 1 10:59  morning      17.7    -56.5  >> cooling states now use the radiator (version 2)
day 1 11:05  noon         19.5    -56.5   1300    35.1   99%  radiator  off    full (full / full)
day 1 11:33  noon         20.0    -56.5   1331    30.0  100%  off       off    full (full / full)
   ... the radiator cycles between 30 °C and 35 °C ...
day 1 13:20  afternoon    20.0    -56.5   1259    29.9  100%  off       off    full (full / full)
day 1 13:30  afternoon    20.0    -46.5   1857    31.7  100%  off       off    half (full / half)
day 1 13:40  afternoon    20.0    -46.5   1822    35.3  100%  radiator  off    half (full / half)
day 1 14:11  afternoon    20.0    -46.5   1690    34.4  100%  radiator  off    full (full / full)
day 1 15:16  afternoon    20.0    -46.5   1319    29.9  100%  off       off    full (full / full)
day 1 15:41  afternoon    20.0    -46.5   1146    35.0  100%  radiator  off    full (full / full)
day 1 16:04  afternoon    20.0    -56.5    650    29.8  100%  off       off    full (full / full)
day 1 17:35  evening      20.0    -56.5    146    24.9  100%  off       off    none
day 1 19:58  night        20.0    -56.5      0     4.9   95%  off       on     none
   ... the heater cycles between 5 °C and 15 °C through the night ...
day 2 06:26  morning      20.0    -56.5    152    14.4   30%  off       on     full (full / full)
day 2 06:32  morning      20.0    -56.5    186    15.1   31%  off       off    full (full / full)
