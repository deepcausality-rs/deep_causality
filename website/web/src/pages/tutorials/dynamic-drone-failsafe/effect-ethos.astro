const soraAnnexA =
  'http://jarus-rpas.org/wp-content/uploads/2024/06/SORA-v2.5-Annex-A-Release.JAR_doc_26-pdf.pdf';
const faa = 'https://www.faa.gov/documentLibrary/media/Advisory_Circular/AC_107-2A.pdf';
const flightpath =
