              ~ ~ / / / . . . / / / / / . . / / / /
              ~ ~ / / / . . . / / / / / / / / / / /
              ~ ~ / / / . . . / / / / / / / / / / /
              ~ ~ / / / . . . / / / / / / / / / / /
              ~ ~ / / / . X . / / / / / / / / / / /
              ~ ~ / / / . . . / / / / / / / / / / /
