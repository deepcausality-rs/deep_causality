---
/**
 * Section 03 — the evidence and its limits, deliberately in one section.
 *
 * Pairing them is the trust move: nobody expects the limitations next to the
 * references, and it is why a reader believes the first half. This section
 * hosts three things — the reference strip, a one-line solver strip, and the
 * boundaries partial — which is why it carries the largest word budget.
 *
 * The strip's four rows are chosen for artifact quality, not for flattery. The
 * cylinder is off it: its own committed capture states that it predates the
 * harness moving into `deep_causality_cfd` and has not been regenerated under
 * the current names, so it cannot sit in a strip whose contract is that every
 * number reproduces. It stays on /validation/ with that provenance attached.
 */
import { validation, statusLabel, statusClass } from '../../data/validation';
import { gateSemantics } from '../../data/boundaries';
import BoundaryTeaser from './BoundaryTeaser.astro';

const featured = ['dec-graded-mms', 'mms-tgv', 'qtt-sod', 'qtt-ramc'];
const rows = featured
  .map((id) => validation.find((v) => v.id === id))
  .filter((v): v is NonNullable<typeof v> => Boolean(v));

const counts = validation.reduce<Record<string, number>>((acc, v) => {
  acc[v.status] = (acc[v.status] ?? 0) + 1;
  return acc;
}, {});
---
<section class="vsnap page" data-rise>
  <header class="sec-head">
    <p class="eyebrow eyebrow-coord">
      <span class="ix">03 / 05</span><span class="lb">Evidence</span>
    </p>
    <h2>Verified, and here is what it cannot do</h2>
    <p class="lede">
      Four published references with their measured deltas, then the things that
      do not work. Both halves come from the same committed artifacts, and every
      target exits nonzero when its check fails.
    </p>
  </header>

  <div class="panel corner-brackets vsnap-panel">
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th scope="col">Target</th>
            <th scope="col">Reference</th>
            <th scope="col">Measured</th>
            <th scope="col">Against</th>
            <th scope="col">Kind</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <th scope="row"><a href={`/validation/#${r.id}`}><code>{r.target}</code></a></th>
              {/* First sentence only. The period must not be a decimal point:
                  splitting on a bare '.' truncated Sod's reference at
                  "star pressure p* = 0", which states the wrong number. */}
              <td>{r.reference.split(/\.(?!\d)/)[0]}</td>
              <td class="num">{r.measured[0].computed}</td>
              <td class="num">{r.measured[0].expected}</td>
              <td><span class:list={['status', statusClass[r.status]]}>{statusLabel[r.status]}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="vsnap-foot">
      <ul class="tally">
        <li><span class="status status-validated">Quantitative</span> {counts.quantitative ?? 0}</li>
        <li><span class="status status-measured">Anchored / invariant</span> {(counts.anchored ?? 0) + (counts.invariant ?? 0)}</li>
        <li><span class="status status-partial">Structural</span> {counts.structural ?? 0}</li>
      </ul>
      <a class="more" href="/validation/">All {validation.length} targets <span aria-hidden="true">→</span></a>
    </div>
  </div>

  <div class="callout callout-warn gate-note">
    <p class="callout-title">A passing gate is not a passing physics target</p>
    <p>{gateSemantics}</p>
  </div>

  <div class="solver-strip panel corner-brackets">
    <h3>Three solvers, one job</h3>
    <p class="body">
      These close the coupled loop without an external dependency. Meshing stays
      with your mesher: this reads no mesh format, and geometry is declared in
      code. Converged flow at scale, turbulence closures and certification stay
      with your solver. A discrete-exterior-calculus discretization,
      divergence-free by construction, carries the incompressible cases. A
      tensor-train-compressed marcher carries the compressible and reacting
      ones. Fitted closures carry the stagnation line.
    </p>
    <a class="more" href="/solvers/">What each is for <span aria-hidden="true">→</span></a>
  </div>

  <BoundaryTeaser />
</section>

<style>
  .vsnap { max-width: var(--w-panel); }
  .sec-head { margin-bottom: var(--space-6); }
  .sec-head h2 { margin: var(--space-3) 0 var(--space-3); }
  .lede { color: var(--fg-1); max-width: var(--measure-lede); margin: 0; }

  .vsnap-panel { padding: var(--space-5); }
  table { width: 100%; border-collapse: collapse; font-size: var(--t-body-sm); }
  th, td { text-align: left; padding: var(--space-3); border-bottom: 1px solid var(--line-1); }
  thead th {
    font-family: var(--font-mono);
    font-size: var(--t-eyebrow);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--fg-2);
    font-weight: 400;
    white-space: nowrap;
  }
  tbody th { font-weight: 400; }
  tbody td { color: var(--fg-1); }
  tbody tr:last-child th, tbody tr:last-child td { border-bottom: none; }
  tbody tr { transition: background-color var(--dur-fast) var(--ease-out); }
  tbody tr:hover { background: color-mix(in srgb, var(--accent) 5%, transparent); }

  .vsnap-foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
    justify-content: space-between;
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line-1);
  }
  .tally { display: flex; flex-wrap: wrap; gap: var(--space-4); list-style: none; margin: 0; padding: 0; }
  .tally li { font-size: var(--t-body-sm); color: var(--fg-1); display: inline-flex; gap: var(--space-2); align-items: baseline; }
  .more { font-size: var(--t-body-sm); border-bottom: none; }
  .more:hover { border-bottom: 1px solid currentColor; }

  .gate-note { margin-top: var(--space-5); }

  .solver-strip { padding: var(--space-5); margin-top: var(--space-5); }
  .solver-strip h3 { font-size: var(--t-h4); margin: 0 0 var(--space-3); }
  .body { color: var(--fg-1); font-size: var(--t-body-sm); max-width: var(--measure); margin: 0 0 var(--space-4); }
</style>
