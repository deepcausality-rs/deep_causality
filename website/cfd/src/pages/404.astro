---
import PageShell from '../components/nav/PageShell.astro';
import { GITHUB_URL } from '../consts';

const title = 'Page not found | DeepCausality CFD';
const description = 'No page exists at this address.';

const links = [
  { href: '/how-it-works/', label: 'How it works', text: 'March a simulation until a condition becomes true, pause, fork the state and compare the branches.' },
  { href: '/examples/', label: 'Examples', text: 'Four studies, each answering one question.' },
  { href: '/tutorial/', label: 'Tutorial', text: 'The corridor, the weather table and the powered descent, read as three programs.' },
  { href: GITHUB_URL, label: 'GitHub repository', text: 'The source code and every committed run output.' },
];
---
<PageShell title={title} description={description} path="/404">
  <header class="doc-head">
    <p class="eyebrow">404</p>
    <h1>Page not found</h1>
    <p class="lede">
      No page exists at this address. The link may be out of date or mistyped.
    </p>
  </header>

  <section class="doc-sec">
    <h2>Where to go from here</h2>
    <dl class="deflist">
      {links.map((l) => (
        <div>
          <dt><a href={l.href}>{l.label}</a></dt>
          <dd>{l.text}</dd>
        </div>
      ))}
    </dl>
  </section>
</PageShell>
