---
/**
 * /blueprints/: the how-to guides. The route keeps its old name; the nav label and the
 * heading say "How-to".
 */
import { getCollection } from 'astro:content';
import PageShell from '../../components/nav/PageShell.astro';
import { CRATE_URL } from '../../consts';

const title = 'How-to guides | DeepCausality CFD';
const description =
  'Task-shaped guides: sweep a parameter into a table, gate a run against a limit, fork a running simulation, couple physics stages and pick a solver.';

const guides = (await getCollection('blueprints')).sort(
  (a, b) => a.data.order - b.data.order
);
---
<PageShell title={title} description={description} path="/blueprints/">
  <header class="doc-head">
    <p class="eyebrow">How-to</p>
    <h1>How-to guides</h1>
    <p class="lede">
      Each guide does one task: the outcome, then the shortest working code, then the explanation.
      The verbs under a title are the <code>CfdFlow</code> calls the guide uses.
    </p>
  </header>

  <section class="doc-sec" id="guides">
    <h2>Which task do you need to do?</h2>
    <ol class="rlist">
      {guides.map((r, i) => (
        <li class="ritem">
          <a href={`/blueprints/${r.id.replace(/^en\//, '')}/`}>
            <span class="rix num">{String(i).padStart(2, '0')}</span>
            <span class="rmain">
              <span class="rtitle">{r.data.title}</span>
              <span class="rtask">{r.data.task}</span>
              <span class="rsummary">{r.data.summary}</span>
              <span class="rverbs">
                {r.data.verbs.map((v) => <code>{v}</code>)}
              </span>
            </span>
            <span class="rgo" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>

    <p class="src-note">
      Generated API documentation lives with the source:
      <a href={CRATE_URL}>deep_causality_cfd <span aria-hidden="true">↗</span></a>
    </p>
  </section>
</PageShell>

<style>
  .doc-sec > .rlist { list-style: none; margin: 0; padding: 0; max-width: none; border-top: 1px solid var(--line-1); }
  .ritem { margin: 0; border-bottom: 1px solid var(--line-1); }
  .ritem a {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: var(--space-4);
    align-items: start;
    padding: var(--space-5) var(--space-2);
    color: var(--fg-0);
    border-bottom: none;
    transform: translate3d(0, 0, 0);
    transition: transform var(--dur-med) var(--ease-out),
                background-color var(--dur-fast) var(--ease-out);
  }
  .ritem a:hover {
    transform: translate3d(var(--space-2), 0, 0);
    background: color-mix(in srgb, var(--accent) 5%, transparent);
  }
  .rix { color: var(--fg-2); }
  .rmain { display: flex; flex-direction: column; gap: var(--space-2); min-width: 0; }
  .rtitle { font-weight: var(--fw-heading); font-size: var(--t-h4); }
  .rtask { color: var(--fg-0); font-size: var(--t-body-sm); }
  .rsummary { color: var(--fg-1); font-size: var(--t-body-sm); max-width: var(--measure); }
  .rverbs { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-1); }
  .rverbs code {
    font-size: var(--t-eyebrow);
    color: var(--fg-2);
    background: none;
    padding: 0;
  }
  .rverbs code::after { content: '·'; margin-left: var(--space-2); color: var(--line-2); }
  .rverbs code:last-child::after { content: ''; }
  .rgo { color: var(--accent); align-self: center; transition: transform var(--dur-fast) var(--ease-out); }
  .ritem a:hover .rgo { transform: translateX(2px); }

  .src-note { color: var(--fg-2); font-size: var(--t-body-sm); margin-top: var(--space-6); }
</style>
