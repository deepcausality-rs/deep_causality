---
/**
 * /examples/: one card per worked example, led by the question it answers.
 * Cards follow the frontmatter `order`. Facts on a card come from the example's
 * own frontmatter, so the index and the detail page cannot disagree.
 */
import { getCollection } from 'astro:content';
import PageShell from '../../components/nav/PageShell.astro';
import { EXAMPLES_URL } from '../../consts';

const title = 'Examples | DeepCausality CFD';
const description =
  'Four runnable examples, each answering one engineering question with committed output and a stated limit.';

const examples = (await getCollection('examples')).sort(
  (a, b) => a.data.order - b.data.order
);
---
<PageShell title={title} description={description} path="/examples/">
  <header class="doc-head">
    <p class="eyebrow">Worked examples</p>
    <h1>Four worked examples</h1>
    <p class="lede">
      Each example answers one engineering question with a program you can run, its committed
      output and a stated limit. They are ordered by the solver and study surface each one needs.
    </p>
  </header>

  <section class="doc-sec" id="examples">
    <h2>Which question do you have?</h2>

    <ol class="elist">
      {examples.map((ex) => {
        const slug = ex.id.replace(/^en\//, '');
        return (
          <li class="ecard panel corner-brackets">
            <a class="ecard-link" href={`/examples/${slug}/`}>
              <span class="eix num">{String(ex.data.order).padStart(2, '0')}</span>
              <div class="ebody">
                <h3 class="equestion">{ex.data.question}</h3>
                <p class="etitle">{ex.data.title}</p>
                <p class="esummary">{ex.data.summary}</p>
                <p class="euses">
                  {ex.data.uses.map((u) => <span class="chip chip-mono">{u}</span>)}
                </p>
                <p class="efoot">
                  <span class="eruntime num">{ex.data.runtime}.</span>
                  {!ex.data.recorded && (
                    <span class="status status-partial">No committed output</span>
                  )}
                </p>
              </div>
              <span class="ego" aria-hidden="true"></span>
            </a>
          </li>
        );
      })}
    </ol>
  </section>

  <section class="doc-sec" id="numbers">
    <h2>Where do the numbers come from?</h2>
    <p>
      Each example page opens with its measured results, quoted from the example’s committed
      <code>output.txt</code>. No <code>output.txt</code> records timing, so the run times on the
      cards are README figures, not measurements from a named machine.
    </p>
    <p class="next-links">
      <a href={EXAMPLES_URL}>Source for all of these <span aria-hidden="true">↗</span></a>
    </p>
  </section>
</PageShell>

<style>
  .elist { list-style: none; margin: 0; padding: 0; max-width: none; display: grid; gap: var(--space-4); }

  .ecard { padding: 0; }
  .ecard-link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: var(--space-4);
    align-items: start;
    padding: var(--space-5);
    color: var(--fg-0);
    border-bottom: none;
    border-radius: var(--radius-md);
    transform: translate3d(0, 0, 0);
    transition: transform var(--dur-med) var(--ease-out),
                background-color var(--dur-fast) var(--ease-out);
  }
  .ecard-link:hover {
    transform: translate3d(0, -2px, 0);
    background: color-mix(in srgb, var(--accent) 5%, transparent);
  }

  .eix { color: var(--fg-2); }
  .ebody { display: flex; flex-direction: column; gap: var(--space-3); min-width: 0; }
  .ebody p { margin: 0; }
  .equestion {
    font-weight: var(--fw-heading);
    font-size: var(--t-h4);
    line-height: var(--lh-h4);
    max-width: var(--measure);
  }
  .etitle {
    font-family: var(--font-mono);
    font-size: var(--t-eyebrow);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--fg-2);
  }
  .esummary { color: var(--fg-1); font-size: var(--t-body-sm); max-width: var(--measure); }
  .euses { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .efoot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: baseline;
    padding-top: var(--space-3);
    border-top: 1px solid var(--line-1);
  }
  .eruntime { color: var(--fg-2); font-size: var(--t-eyebrow); }
  .ego::after { content: '→'; color: var(--accent); display: inline-block; transition: transform var(--dur-fast) var(--ease-out); }
  .ecard-link:hover .ego::after { transform: translateX(2px); }
</style>
