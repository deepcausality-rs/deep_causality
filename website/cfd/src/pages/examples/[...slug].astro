---
import { getCollection, render } from 'astro:content';
import { Code } from 'astro:components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/nav/SiteHeader.astro';
import DocDetail from '../../components/docs/DocDetail.astro';
import { rustDark, rustLight } from '../../../shiki-rust-themes.mjs';
import { GITHUB_URL } from '../../consts';

const SHIKI = { light: rustLight, dark: rustDark };

export async function getStaticPaths() {
  const entries = await getCollection('examples');
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/^en\//, '') },
    props: { entry },
    // Incremental build: this page renders from `entry` alone, so the entry's
    // content digest is a complete cache key.
    cacheKey: entry.digest,
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const meta = [{ label: 'Run time', value: `${d.runtime}.`, mono: true }];

// Order on the page: the measured results and their limit, then the command, then the
// explanation. The command is rendered in the body rather than by DocDetail, whose header
// would place it above the results.
---
<BaseLayout
  title={`${d.title} | DeepCausality CFD`}
  description={d.summary}
  path={`/examples/${entry.id.replace(/^en\//, '')}/`}
>
  <SiteHeader slot="header" />

  <DocDetail
    eyebrow="Worked example"
    title={d.title}
    summary={d.question}
    tags={d.uses}
    meta={meta}
    unrecordedNote={d.recorded ? undefined : 'figures come from the example README'}
    backHref="/examples/"
    backLabel="All examples"
    sourceHref={`${GITHUB_URL}/tree/main/${d.source}`}
    sourceLabel="Source"
  >
    <section class="measured">
      <p class="mk">Measured</p>
      <ul>
        {d.results.map((r) => <li><code class="num">{r}</code></li>)}
      </ul>
    </section>

    <section class="limit">
      <p class="mk">Stated limitation</p>
      <p>{d.limitation}</p>
    </section>

    <section class="run">
      <p class="mk">Run it</p>
      <Code code={d.command} lang="bash" themes={SHIKI} />
    </section>

    <Content />
  </DocDetail>
</BaseLayout>

<style>
  .measured { margin: 0 0 var(--space-5); }
  .mk {
    font-family: var(--font-mono);
    font-size: var(--t-eyebrow);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--fg-2);
    margin: 0 0 var(--space-3);
  }
  .measured ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-2); }
  .measured li {
    color: var(--fg-1);
    padding-left: var(--space-3);
    border-left: 1px solid var(--accent);
  }
  .measured code { background: none; padding: 0; color: inherit; }
  .limit {
    margin: 0 0 var(--space-6);
    padding: var(--space-4);
    background: var(--bg-2);
    border-radius: var(--radius-sm);
    border-left: 3px solid var(--warn);
  }
  .limit p:last-child { color: var(--fg-1); font-size: var(--t-body-sm); margin: 0; }
  .run { margin: 0 0 var(--space-6); }
</style>
