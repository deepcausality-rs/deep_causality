---
/**
 * /roadmap/: the line between what works today and what does not. Three lists are stages of one
 * ladder (works today, building, open). The fourth holds decisions with their reasons.
 *
 * Sources: verification/qtt_sod/baseline.txt, verification/qtt_ramc_stagline/baseline.txt,
 * studies/qtt_rank_plume/output.txt, retropropulsion/output.txt, benches and studies READMEs, and
 * the compile_fail doctests on `CfdFlow::study`.
 */
import PageShell from '../../components/nav/PageShell.astro';
import { MACHINE } from '../../consts';

const title = 'Roadmap | DeepCausality CFD';
const description =
  'What runs today, what is being built, what is unsolved and what the project chose not to build, with the measurement or reason behind each item.';

const now = [
  {
    item: 'Incompressible flow on fixed meshes (the DEC solver)',
    note: 'Validation targets cover the Ghia lid-driven cavity at Re 1000, the cylinder wake at Re 100 and a graded-mesh manufactured solution. The manufactured solution converges at observed order 1.98 to 2.01 against a design order of 2.00.',
  },
  {
    item: 'Compressible flow in 1-D to 3-D (the QTT solvers)',
    note: 'The Sod shock tube matches the exact Riemann solution, with L1 errors of 0.0175 (density), 0.0274 (velocity) and 0.0151 (pressure) against a 0.03 tolerance.',
  },
  {
    item: 'Closed-form shock, relaxation and ionization models (the fitted closures)',
    note: 'For the RAM-C II flight test, the finite-rate ionization network predicts a peak electron density of 1.643e19 m⁻³ against the flight value of 9.93e18 m⁻³ at 71.93 km (+0.22 decades). It uses no calibration.',
  },
  {
    item: 'The study language, with step order enforced at compile time',
    note: 'A study runs sweep, record, gates and verdict in that order. Five compile-fail doctests reject a mis-ordered study.',
  },
  {
    item: 'Forks of a paused simulation state',
    note: 'Branches share the paused state until one writes to it, and a gate confirms that no tensor is copied at fork time. A continued branch costs about the same as an unforked march, and a coasting branch costs 0.66 times as much.',
  },
  {
    item: 'Precision as a type parameter',
    note: 'The same physics runs at f32, f64 and Float106, switched at one alias. The plasma-blackout corridor does not currently compile at Float106.',
  },
  {
    item: 'Plasma retropropulsion descent, blackout exit to touchdown',
    note: `Sixteen gates pass in 346.9 s on ${MACHINE}. Branches forked mid-burn depart a frozen-drag prediction by up to 179.9 m/s.`,
  },
];

const building = [
  {
    item: 'A bounded rank for a marched shock',
    note: 'Treating the shock front as an exact Rankine–Hugoniot interface and marching smooth flow on each side holds the rank (bond 8) flat as resolution grows. Marching fluxes through the front grows it from 25 to 35.',
  },
  {
    item: 'Grid-convergence study for the cylinder',
    note: 'Grids of 16, 24 and 32 cells per diameter, Richardson-extrapolated, plus C_L,rms, the separation angle θ_sep and the base pressure C_pb. Any DNS-grade accuracy claim waits for it.',
  },
];

const later = [
  {
    item: 'Turbulence, staged on the DEC solver',
    note: 'Large-eddy simulation (LES) follows once the spectra observables land. The wake is reported and never gated.',
  },
  {
    item: 'A tractable 3-D fitted marcher',
    note: 'At 16³ with a bond cap of 16 it runs more than 3× over the ten-minute budget, so the shipped corridor marches a 2-D layer.',
  },
  {
    item: 'Plume-resolved compressible supersonic retropropulsion (SRP) on QTT solvers',
    note: 'The rank of a colliding-shock system is unmeasured in this format. It is open research.',
  },
  {
    item: 'Off-axis SRP, thrust vectoring, 6-DOF (six degrees of freedom)',
    note: 'Off-axis flight leaves the validated envelope of the Cordell–Braun correlation, so a surprising result could not be traced to a cause. The project excludes these cases for that reason.',
  },
];

/**
 * Stated non-goals. Not a fourth stage of the ladder: these are decisions, and an unstated
 * decision reads as a gap. Both are on record in the project's own de-risk verdict.
 */
const nonGoals = [
  {
    item: 'Distributed execution across a cluster',
    note: 'The branches of a study already run across the cores of one machine and match a sequential run bit for bit. A cluster gives an early user no answer they cannot get now, and it adds a deployment and operations surface to maintain indefinitely.',
  },
  {
    item: 'GPU acceleration for QTT solvers',
    note: 'Deferred, not refused. A single state at bond ≤ 64 is latency-bound small-matrix work, and double precision rules out the local hardware; a GPU pays off on large batches of branches, or at 3-D and bond ≥ 128.',
  },
];

const marks = [
  { cls: 'status-validated', label: 'Works today', text: 'A committed run output or verification baseline backs the item.' },
  { cls: 'status-partial', label: 'Building', text: 'A de-risk study (a small measurement of whether the approach can work) exists and the work is under way.' },
  { cls: 'status-roadmap', label: 'Open', text: 'An unsolved question with no scheduled date.' },
  { cls: 'status-nongoal', label: 'Not pursued', text: 'A decision not to build the item, with its reason.' },
];

const lists = [
  { cls: 'status-validated', label: 'Works today', items: now },
  { cls: 'status-partial', label: 'Building', items: building },
  { cls: 'status-roadmap', label: 'Open', items: later },
  { cls: 'status-nongoal', label: 'Not pursued', items: nonGoals },
];
---
<PageShell title={title} description={description} path="/roadmap/">
  <header class="doc-head">
    <p class="eyebrow">Roadmap</p>
    <h1>What works today, and what does not</h1>
    <p class="lede">
      Four lists mark the line between what runs now and what does not. Each item names its
      evidence or its reason.
    </p>
  </header>

  <section class="doc-sec" id="meaning">
    <h2>What does each list mean?</h2>
    <dl class="deflist">
      {marks.map((m) => (
        <div>
          <dt><span class={`status ${m.cls}`}>{m.label}</span></dt>
          <dd>{m.text}</dd>
        </div>
      ))}
    </dl>
    <p>
      QTT, DEC, bond and rank are defined on <a href="/solvers/">the solvers page</a>.
    </p>
  </section>

  {lists.map((l) => (
    <section class="doc-sec">
      <h2><span class={`status ${l.cls}`}>{l.label}</span></h2>
      <ul class="rlist">
        {l.items.map((r) => (
          <li>
            <span class="ritem">{r.item}</span>
            <span class="rnote">{r.note}</span>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <section class="doc-sec" id="maintenance">
    <h2>How does an item move between lists?</h2>
    <p>
      An item moves from <em>open</em> to <em>building</em> once a de-risk study exists. It moves
      from <em>building</em> to <em>works today</em> once a self-verifying target or a committed
      example output covers it. Four items were removed after measurement refuted them; the
      <a href="/boundaries/">limits page</a> records them.
    </p>
    <p>
      Nothing leaves <em>not pursued</em> on effort alone. An entry changes only if its reason
      stops holding, and the reason is stated so you can judge that yourself.
    </p>
  </section>
</PageShell>

<style>
  .doc-sec > .rlist { list-style: none; margin: 0; padding: 0; max-width: none; }
  .rlist li {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2);
    margin: 0;
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--line-1);
  }
  @media (min-width: 720px) {
    .rlist li { grid-template-columns: 1fr 1.3fr; gap: var(--space-5); align-items: baseline; }
  }
  .rlist li:last-child { border-bottom: none; }
  .ritem { color: var(--fg-0); }
  .rnote { color: var(--fg-1); font-size: var(--t-body-sm); }
</style>
