---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/nav/SiteHeader.astro';
import Hero from '../components/home/Hero.astro';
import SectionDivider from '../components/home/SectionDivider.astro';
import CounterfactualDynamics from '../components/home/CounterfactualDynamics.astro';
import RegimeChange from '../components/home/RegimeChange.astro';
import Multiphysics from '../components/home/Multiphysics.astro';
import SolverStack from '../components/home/SolverStack.astro';
import Provenance from '../components/home/Provenance.astro';
import ValidationSnapshot from '../components/home/ValidationSnapshot.astro';
import ExampleLadder from '../components/home/ExampleLadder.astro';
import { GITHUB_URL } from '../consts';

const title = 'DeepCausality CFD — Counterfactual Fluid Dynamics in Rust';
const description =
  'A Rust CFD toolbox that couples flow, chemistry, navigation and control in one typed process, then forks the running simulation into counterfactual worlds. Validated against Sod, Ghia, Williamson and RAM-C II, with measured capability boundaries.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: 'deep_causality_cfd',
  description,
  programmingLanguage: 'Rust',
  codeRepository: GITHUB_URL,
  license: 'https://opensource.org/licenses/MIT',
};
---
<BaseLayout title={title} description={description} path="/">
  <SiteHeader slot="header" />

  <!-- The five arguments, in the order the crate README makes them, then the
       evidence for all five. -->
  <Hero />
  <SectionDivider />
  <CounterfactualDynamics />
  <SectionDivider />
  <RegimeChange />
  <SectionDivider />
  <Multiphysics />
  <SectionDivider />
  <SolverStack />
  <SectionDivider />
  <Provenance />
  <SectionDivider />
  <ValidationSnapshot />
  <SectionDivider />
  <ExampleLadder />

  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
</BaseLayout>
