---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/nav/SiteHeader.astro';
import Hero from '../components/home/Hero.astro';
import SectionDivider from '../components/home/SectionDivider.astro';
import ForkNotSweep from '../components/home/ForkNotSweep.astro';
import NoCluster from '../components/home/NoCluster.astro';
import ValidationSnapshot from '../components/home/ValidationSnapshot.astro';
import Practice from '../components/home/Practice.astro';
import WhereItFits from '../components/home/WhereItFits.astro';
import { GITHUB_URL } from '../consts';

const title = 'DeepCausality CFD — Counterfactual Fluid Dynamics in Rust';
const description =
  'Fork a coupled simulation at the moment the physics gets interesting and fly every what-if from the state the vehicle actually reached, instead of rerunning each case from a checkpoint. Validated against Sod, Ghia, Williamson and RAM-C II, with measured capability boundaries.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: 'deep_causality_cfd',
  description,
  programmingLanguage: 'Rust',
  codeRepository: GITHUB_URL,
  license: 'https://opensource.org/licenses/MIT',
};
---
<BaseLayout title={title} description={description} path="/">
  <SiteHeader slot="header" />

  <!-- Five sections, ordered by what a cold reader needs in order to keep
       reading: what it does, whether it fits their machine, whether the physics
       holds and where it stops, what the day looks like, and where it sits. -->
  <Hero />
  <SectionDivider />
  <ForkNotSweep />
  <SectionDivider />
  <NoCluster />
  <SectionDivider />
  <ValidationSnapshot />
  <SectionDivider />
  <Practice />
  <SectionDivider />
  <WhereItFits />

  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
</BaseLayout>
