---
/**
 * The mechanism as four verbs, each tied to the API name it becomes in the
 * program below it. The code is condensed from
 * `examples/quantum_examples/qcl_examples/qcl_crosstalk/main.rs`: it drops the
 * printing, the observation and the construction of the worlds, and keeps
 * every call that carries a step.
 */
import { Code } from 'astro:components';
import { rustDark, rustLight } from '../../../shiki-rust-themes.mjs';
import { EXAMPLES_URL } from '../../consts';

const SHIKI = { light: rustLight, dark: rustDark };

const steps = [
  {
    verb: 'Declare',
    text: 'Name the plant, the candidate structures, and the experiments you could run, each with a cost and a predicted read-out under every candidate. A candidate that is a cycle is refused here.',
    api: 'config(…).candidates(…).probes(…).build()',
  },
  {
    verb: 'Screen',
    text: 'Each candidate faces two checks: its factors must form a legal quantum causal model, and its structure must admit a circuit that realises it faithfully. A check reports what it measured, its threshold, its margin and how many items it examined.',
    api: 'validate(&cfg).check_markov(…).finalize()',
  },
  {
    verb: 'Plan',
    text: 'Structural candidates reach control only through the screen. Control forks one world per admitted candidate and picks the cheapest experiments that separate each coverable pair of candidates by a floor of bits.',
    api: 'control(&screened).fork().design(…)',
  },
  {
    verb: 'Decide',
    text: 'Judge each world’s prediction against the observation and fold the verdicts. The result is one survivor, or a named ambiguity when the data leaves several standing.',
    api: 'adjudicate(&worlds, floor_bits)',
  },
];

const code = `// 1. Declare. A fourth candidate that is a cycle makes build() return
//    CyclicStructureUnsupported.
let cfg = QclBuilder::config::<FloatType, NumberType>()
    .over_plant(plant()?, &[e2_projector()?, e1_projector()?])
    .candidates(&[h1_direct_q1_to_q2()?, h2_direct_q2_to_q1()?, h3_common_bath()?])
    .probes(&experiments()?)
    .seed(SEED)
    .build()?;

// 2. Screen. Each check returns a report; the screen admits what passes both.
let screened = QclBuilder::validate(&cfg)
    .check_markov(&CommutatorTolerance::<FloatType>::default())
    .check_decomposable(&sys, &sys)
    .finalize()?;

// 3. Plan. Fork one world per admitted candidate, then solve the minimum-cost cover.
let report = QclBuilder::control::<FloatType, NumberType, 4, _>(&screened)
    .fork()
    .design(MinCostCover::new(floor_bits))
    .finalize()?;

// 4. Decide. \`worlds\` holds each candidate's verdict on the observation.
let a = adjudicate(&worlds, floor_bits)?;`;
---
<div class="steps">
  <ol class="cards">
    {steps.map((s, i) => (
      <li class="card panel corner-brackets rise" style={`--i:${i}`}>
        <svg class="glyph" viewBox="0 0 120 44" fill="none" aria-hidden="true" focusable="false">
          {i === 0 && (
            <>
              <line x1="20" y1="10" x2="60" y2="10" />
              <line x1="20" y1="10" x2="40" y2="36" />
              <line x1="40" y1="36" x2="60" y2="10" class="warn" stroke-dasharray="3 3" />
              <circle cx="20" cy="10" r="4" />
              <circle cx="60" cy="10" r="4" />
              <circle cx="40" cy="36" r="4" class="acc" />
              <line x1="86" y1="14" x2="106" y2="34" class="warn" />
              <line x1="106" y1="14" x2="86" y2="34" class="warn" />
            </>
          )}
          {i === 1 && (
            <>
              <line x1="8" y1="10" x2="52" y2="10" />
              <line x1="8" y1="22" x2="52" y2="22" />
              <line x1="8" y1="34" x2="52" y2="34" />
              <line x1="58" y1="4" x2="58" y2="40" class="acc" />
              <line x1="64" y1="10" x2="100" y2="10" />
              <line x1="64" y1="22" x2="100" y2="22" />
              <path d="M104,30 l5,5 l9,-11" class="acc" />
            </>
          )}
          {i === 2 && (
            <>
              <line x1="8" y1="8" x2="112" y2="8" />
              <line x1="8" y1="18" x2="20" y2="18" class="acc" />
              <line x1="8" y1="28" x2="20" y2="28" class="acc" />
              <line x1="8" y1="38" x2="26" y2="38" />
            </>
          )}
          {i === 3 && (
            <>
              <line x1="14" y1="10" x2="86" y2="22" />
              <line x1="14" y1="22" x2="86" y2="22" class="acc" />
              <line x1="14" y1="34" x2="86" y2="22" />
              <circle cx="14" cy="10" r="3" />
              <circle cx="14" cy="22" r="3" class="acc" />
              <circle cx="14" cy="34" r="3" />
              <circle cx="96" cy="22" r="7" class="acc" />
            </>
          )}
        </svg>
        <p class="n">{i + 1}</p>
        <h3>{s.verb}</h3>
        <p class="t">{s.text}</p>
        <p class="api"><code>{s.api.split(/(?<=\.)/).map((part) => <Fragment>{part}<wbr /></Fragment>)}</code></p>
      </li>
    ))}
  </ol>

  <details class="prog">
    <summary>See the program in Rust</summary>
    <Code code={code} lang="rust" themes={SHIKI} />
    <p class="src">
      Condensed from the crosstalk example’s
      <a href={`${EXAMPLES_URL}/qcl_examples/qcl_crosstalk/main.rs`}><code>main.rs</code></a>.
    </p>
  </details>
</div>

<style>
  .cards {
    list-style: none;
    margin: 0 0 var(--space-6);
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }
  @media (min-width: 620px) { .cards { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1000px) { .cards { grid-template-columns: repeat(4, 1fr); } }

  .card { padding: var(--space-5); display: flex; flex-direction: column; }
  .glyph { width: 100%; max-width: 8rem; height: auto; margin-bottom: var(--space-4); }
  .glyph line, .glyph path, .glyph circle {
    stroke: var(--fg-1);
    stroke-width: 1.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .glyph circle { fill: none; }
  .glyph .acc { stroke: var(--accent); }
  .glyph .warn { stroke: var(--warn); }

  .n {
    font-family: var(--font-mono);
    font-size: var(--t-eyebrow);
    letter-spacing: var(--ls-eyebrow);
    color: var(--fg-2);
    margin: 0 0 var(--space-1);
  }
  .card h3 { font-size: var(--t-h3); margin: 0 0 var(--space-3); }
  .t { color: var(--fg-1); font-size: var(--t-body-sm); margin: 0 0 var(--space-4); }
  .api { margin: auto 0 0; padding-top: var(--space-3); border-top: 1px solid var(--line-1); }
  .api code { background: none; padding: 0; color: var(--accent); font-size: var(--t-eyebrow); overflow-wrap: break-word; }

  .src { color: var(--fg-2); font-size: var(--t-body-sm); margin: 0; }

  .prog summary {
    cursor: pointer;
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    margin-bottom: var(--space-4);
    border: 1px solid var(--line-2);
    border-radius: var(--radius-sm);
    color: var(--fg-0);
    font-size: var(--t-body-sm);
    transition: border-color var(--dur-fast) var(--ease-out), background-color var(--dur-fast) var(--ease-out);
  }
  .prog summary::-webkit-details-marker { display: none; }
  .prog summary::before { content: '+'; font-family: var(--font-mono); color: var(--accent); }
  .prog[open] summary::before { content: '−'; }
  .prog summary:hover { border-color: var(--fg-2); background: color-mix(in srgb, var(--accent) 5%, transparent); }
</style>
