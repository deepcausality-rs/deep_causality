---
/**
 * Hero. States what the library is and does, then shows three verdicts.
 *
 * The reader has basic quantum background and has never seen this library. The
 * headline says what the library produces, the sub says the three things it
 * decides in that reader's words, and the figure shows one real verdict for each.
 * "QCL" and the builder's calls sit in the gloss, where they label the page
 * without carrying it.
 */
import HeroVerdicts from './HeroVerdicts.astro';
---
<section class="hero">
  <div class="hero-inner">
    <p class="eyebrow">Rust library for quantum causal reasoning</p>
    <h1>
      <span>Find the cause. Verify the code.</span>
      <span>Bound the error.</span>
    </h1>

    <div class="hero-grid">
      <div class="hero-copy">
        <p class="sub">
          DeepCausality Quantum finds the causal structure behind correlated
          qubit errors, verifies error-correcting codes without simulating
          them, and bounds the error of stacked codes. Each verdict shows its
          evidence.
        </p>
        <p class="gloss">
          You write problems in QCL, the Quantum Causal Language, a Rust
          builder. Programs run locally on simulated evidence and drive no
          hardware.
        </p>

        <div class="cta-row">
          <a class="btn btn-primary" href="/how-it-works/">
            See how it works
            <span class="btn-ico" aria-hidden="true">→</span>
          </a>
          <a class="btn btn-ghost" href="#run">Run it yourself</a>
        </div>
      </div>

      <div class="hero-fig"><HeroVerdicts /></div>
    </div>
  </div>
</section>

<style>
  .hero { padding: var(--space-7) var(--space-4) var(--space-8); }
  @media (min-width: 720px) { .hero { padding: var(--space-8) var(--space-5) var(--space-9); } }

  .hero-inner { max-width: calc(var(--w-doc) - 2 * var(--space-5)); margin: 0 auto; }

  h1 {
    font-size: clamp(1.875rem, 3.2vw + 0.5rem, 3.25rem);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
    margin: var(--space-3) 0 var(--space-6);
  }
  h1 span { display: block; }
  h1 span:last-child { color: var(--fg-1); }

  /* Narrow screens: intro, then the figure, then the proof and the buttons, so the
     demonstration is on the first screen. `display: contents` lets the copy's
     children join the grid's ordering; wide screens restore two columns. */
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
    align-items: start;
  }
  .hero-copy { display: contents; }
  .sub { order: 1; }
  .hero-fig { order: 2; margin-bottom: var(--space-6); }
  .gloss { order: 1; }
  .cta-row { order: 4; }
  @media (min-width: 1000px) {
    .hero-grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--space-8); align-items: center; }
    .hero-copy { display: block; }
    .hero-fig { order: 0; margin-bottom: 0; }
  }

  .sub {
    color: var(--fg-0);
    font-size: var(--t-h4);
    line-height: var(--lh-h4);
    max-width: var(--measure-lede);
    margin: 0 0 var(--space-5);
  }
  .gloss {
    color: var(--fg-1);
    font-size: var(--t-body-sm);
    max-width: var(--measure-lede);
    margin: 0 0 var(--space-5);
  }
  .cta-row { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-bottom: var(--space-5); }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    height: 44px;
    padding: 0 var(--space-5);
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    font-size: var(--t-body-sm);
    font-weight: var(--fw-heading);
    transition: transform var(--dur-fast) var(--ease-out),
                background-color var(--dur-fast) var(--ease-out),
                border-color var(--dur-fast) var(--ease-out),
                color var(--dur-fast) var(--ease-out);
  }
  .btn:active { transform: translateY(1px); }
  .btn-primary { background: var(--accent); color: var(--accent-ink); }
  .btn-primary:hover {
    background: color-mix(in srgb, var(--accent) 90%, white);
    border-color: transparent;
  }
  .btn-ico { transition: transform var(--dur-fast) var(--ease-out); }
  .btn-primary:hover .btn-ico { transform: translateX(2px); }
  .btn-ghost { color: var(--fg-0); border-color: var(--line-2); }
  .btn-ghost:hover {
    border-color: var(--fg-2);
    background: color-mix(in srgb, var(--accent) 5%, transparent);
  }
</style>
