---
/**
 * What the library has been checked against. Each row names its source, so a
 * reader can rerun it. The theorem count is the figure the theorem map reports:
 *   theorems the quantum section of lean/THEOREM_MAP.md, rows marked proved
 *   tests    cargo test -p deep_causality_quantum --all-features, all passing
 * Statuses use the shared `.status` marks.
 */
import { TESTS } from '../../data/evidence';

const rows = [
  {
    status: 'validated',
    mark: 'proved',
    title: `${TESTS.proved} theorems proved in Lean`,
    text: 'The theorems cover the partial-trace identities, the Choi–Jamiołkowski layer including the reconstruction of a channel, exact abstraction composition, the orthomodular verdict lattice and the laws of quantum causal models. Each theorem is paired with a named Rust test on the same statement.',
    href: '/proof/#theorems',
  },
  {
    status: 'validated',
    mark: 'refuted',
    title: 'Commuting operators can stop commuting under a partial trace',
    text: 'Lean proves an explicit pair with [X, Y] = 0 and [Tr_B X, Tr_B Y] = +4i·σy. The library’s boundary check therefore returns a bound with a stated √(d_B) amplification and a flag against your tolerance.',
    href: '/proof/#refuted',
  },
  {
    status: 'partial',
    mark: 'not proved',
    title: 'One target remains open',
    text: 'Lorenz and Barrett’s unitary factorization needs the commutant and direct-sum decomposition of finite-dimensional C*-algebras, which Mathlib lacks. Every other quantum target is proved.',
    href: '/proof/#deferred',
  },
];
---
<ul class="rows">
  {rows.map((r, i) => (
    <li class="row panel corner-brackets rise" style={`--i:${i}`}>
      <p class={`status status-${r.status}`}>{r.mark}</p>
      <h3>{r.title}</h3>
      <p class="t">{r.text}</p>
      <p class="go"><a href={r.href}>Details <span aria-hidden="true">→</span></a></p>
    </li>
  ))}
</ul>

<style>
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }
  @media (min-width: 720px) { .rows { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1100px) { .rows { grid-template-columns: repeat(3, 1fr); } }

  .row { padding: var(--space-5); display: flex; flex-direction: column; }
  .status { margin: 0 0 var(--space-3); }
  .row h3 { font-size: var(--t-h4); margin: 0 0 var(--space-3); }
  .t { color: var(--fg-1); font-size: var(--t-body-sm); margin: 0 0 var(--space-4); }
  .go { margin: auto 0 0; font-size: var(--t-body-sm); }
</style>
