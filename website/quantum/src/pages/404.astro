---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/nav/SiteHeader.astro';
---
<BaseLayout
  title="Not found | DeepCausality Quantum"
  description="No page exists at this address."
  path="/404"
>
  <SiteHeader slot="header" />

  <article class="static-page">
    <header>
      <p class="eyebrow">404</p>
      <h1>Page not found</h1>
      <p class="lede">
        No page exists at this address. The links below lead to every page on the site.
      </p>
    </header>

    <ul class="hairline-list">
      <li><a href="/">Overview</a></li>
      <li><a href="/how-it-works/">How it works</a></li>
      <li><a href="/examples/">Examples</a></li>
      <li><a href="/checks/">Checks</a></li>
      <li><a href="/proof/">Proof</a></li>
      <li><a href="/boundaries/">Boundaries</a></li>
      <li><a href="/start/">Get started</a></li>
    </ul>
  </article>
</BaseLayout>
