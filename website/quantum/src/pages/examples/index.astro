---
import { getCollection } from 'astro:content';
import PageShell from '../../components/nav/PageShell.astro';
import { EXAMPLES_URL } from '../../consts';
import { numberWord } from '../../data/evidence';

const title = 'Examples | DeepCausality Quantum';
const description =
  'Sixteen runnable examples, grouped by the question each answers. Eleven use this crate; five are quantum in subject and build on sibling crates.';

const all = (await getCollection('examples')).sort((a, b) => a.data.order - b.data.order);
const slug = (id: string) => id.replace(/^en\//, '');

const groups = [
  { key: 'decide', title: 'Decide between rival causes', note: 'These examples declare candidate structures, screen them, plan the cheapest experiments and name the survivor.' },
  { key: 'model', title: 'Check a quantum causal model', note: 'These examples test whether the factors that share a Hilbert leg commute; a failure names the pair.' },
  { key: 'code', title: 'Verify an error-correcting code', note: 'This example runs exact checks over F₂ on a toric code, with no state vector.' },
  { key: 'compose', title: 'Compose abstractions', note: 'These examples stack one abstraction on another and compare the measured error with the bound of the composition law.' },
  { key: 'sense', title: 'Attribute a sensor’s systematic', note: 'These examples plan experiments in instrument time on an atom interferometer and name the systematic the evidence leaves. The sensing page shows both.' },
  { key: 'other', title: 'Quantum in subject, built on other crates', note: 'The first example, the IKKT matrix model, calls this crate’s commutator kernel. The other five do not import this crate, and each page names the crates it imports.' },
] as const;

const total = all.length;
const usesCount = all.filter((e) => e.data.usesCrate).length;
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
---
<PageShell title={title} description={description} path="/examples/">
  <header class="doc-head">
    <p class="eyebrow">Examples</p>
    <h1>{cap(numberWord(total))} runnable examples, grouped by the question they answer.</h1>
    <p class="lede">
      {cap(numberWord(usesCount))} of them use this crate. The other {numberWord(total - usesCount)}
      are quantum in subject and build on sibling crates, so running one of them does not exercise the
      QCL builder (QCL is the Quantum Causal Language). A row lists the items of this crate that an example
      calls or, for those {numberWord(total - usesCount)}, the crates it imports. The examples in the first four groups
      exit nonzero when one of their checks fails.
    </p>
  </header>

  {groups.map((g) => {
    const items = all.filter((e) => e.data.group === g.key);
    return (
      <section class="doc-sec" id={g.key}>
        <h2>{g.title}</h2>
        <p class="gnote">{g.note}</p>
        <ol class="rlist">
          {items.map((e) => (
            <li class="ritem">
              <a href={`/examples/${slug(e.id)}/`}>
                <span class="rix num">{String(e.data.order).padStart(2, '0')}</span>
                <span class="rmain">
                  <span class="rtitle">{e.data.title}</span>
                  <span class="rq">{e.data.question}</span>
                  <span class="rsummary">{e.data.summary}</span>
                  <span class="rverbs">
                    {(e.data.usesCrate ? e.data.uses : e.data.crates).map((v) => <code>{v}</code>)}
                  </span>
                </span>
                <span class="rgo" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    );
  })}

  <p class="src-note">
    Sources: <a href={EXAMPLES_URL}>examples/quantum_examples <span aria-hidden="true">↗</span></a>
  </p>
</PageShell>

<style>
  .gnote { color: var(--fg-1); font-size: var(--t-body-sm); max-width: var(--measure); margin: 0 0 var(--space-4); }

  .rlist { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line-1); }
  .ritem { border-bottom: 1px solid var(--line-1); }
  .ritem a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: var(--space-4);
    align-items: start;
    padding: var(--space-5) var(--space-2);
    color: var(--fg-0);
    border-bottom: none;
    transform: translate3d(0, 0, 0);
    transition: transform var(--dur-med) var(--ease-out),
                background-color var(--dur-fast) var(--ease-out);
  }
  .ritem a:hover {
    transform: translate3d(var(--space-2), 0, 0);
    background: color-mix(in srgb, var(--accent) 5%, transparent);
  }
  .rix { color: var(--fg-2); }
  .rmain { display: flex; flex-direction: column; gap: var(--space-2); min-width: 0; }
  .rtitle { font-weight: var(--fw-heading); font-size: var(--t-h4); }
  .rq { color: var(--fg-0); font-size: var(--t-body-sm); }
  .rsummary { color: var(--fg-1); font-size: var(--t-body-sm); max-width: var(--measure); }
  .rverbs { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-1); }
  .rverbs code {
    font-size: var(--t-eyebrow);
    color: var(--fg-2);
    background: none;
    padding: 0;
  }
  .rverbs code::after { content: '·'; margin-left: var(--space-2); color: var(--line-2); }
  .rverbs code:last-child::after { content: ''; }
  .rgo { color: var(--accent); align-self: center; transition: transform var(--dur-fast) var(--ease-out); }
  .ritem a:hover .rgo { transform: translateX(2px); }

  .src-note { color: var(--fg-2); font-size: var(--t-body-sm); margin-top: var(--space-6); }
</style>
