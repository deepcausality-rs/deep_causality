load("@crates//:defs.bzl", "aliases", "all_crate_deps", "lint_config")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")

rust_library(
    name = "dynamic_drone_failsafe",
    srcs = glob(["src/**"]),
    aliases = aliases(),
    crate_root = "src/lib.rs",
    lint_config = lint_config(),
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)

rust_binary(
    name = "drone_failsafe_part_1",
    srcs = glob(["part_1_dynamic_causality/**/*.rs"]),
    crate_root = "part_1_dynamic_causality/main.rs",
    visibility = ["//visibility:public"],
    deps = [
        # Cargo puts the package's own lib on an example's extern prelude.
        ":dynamic_drone_failsafe",
    ] + all_crate_deps(
        normal = True,
        # Cargo `[[example]]` targets link dev-dependencies.
        normal_dev = True,
    ),
)

rust_binary(
    name = "drone_failsafe_part_2",
    srcs = glob(["part_2_dynamic_context/**/*.rs"]),
    crate_root = "part_2_dynamic_context/main.rs",
    visibility = ["//visibility:public"],
    deps = [
        ":dynamic_drone_failsafe",
    ] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

rust_binary(
    name = "drone_failsafe_part_3",
    srcs = glob(["part_3_dynamic_action/**/*.rs"]),
    crate_root = "part_3_dynamic_action/main.rs",
    visibility = ["//visibility:public"],
    deps = [
        ":dynamic_drone_failsafe",
    ] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

rust_binary(
    name = "drone_failsafe_part_4",
    srcs = glob(["part_4_effect_ethos/**/*.rs"]),
    crate_root = "part_4_effect_ethos/main.rs",
    visibility = ["//visibility:public"],
    deps = [
        ":dynamic_drone_failsafe",
    ] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

rust_binary(
    name = "drone_failsafe_part_5",
    # Part 5 mounts the controllers of parts 1, 3 and 4 from their own folders.
    srcs = glob([
        "part_5_verification/**/*.rs",
        "part_1_dynamic_causality/**/*.rs",
        "part_3_dynamic_action/**/*.rs",
        "part_4_effect_ethos/**/*.rs",
    ]),
    crate_root = "part_5_verification/main.rs",
    visibility = ["//visibility:public"],
    deps = [
        ":dynamic_drone_failsafe",
    ] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
