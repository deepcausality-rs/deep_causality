load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_doc", "rust_doc_test", "rust_library", "rust_test")

rust_library(
    name = "deep_causality_haft",
    srcs = glob([
        "src/**",
    ]),
    crate_features = [
        "std",
        "alloc",
    ],
    crate_root = "src/lib.rs",
    tags = [
        "HAFT",
        "HKT",
        "utils",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//deep_causality_unified_math/deep_causality_algebra",
    ],
)

rust_doc(
    name = "doc",
    crate = ":deep_causality_haft",
    tags = ["doc"],
    visibility = ["//visibility:public"],
)

rust_doc_test(
    name = "doc_test",
    crate = ":deep_causality_haft",
    tags = ["doc-test"],
    visibility = ["//visibility:public"],
)

