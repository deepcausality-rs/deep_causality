load("@crates//:defs.bzl", "aliases", "all_crate_deps", "lint_config")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rust//rust:defs.bzl", "rust_doc", "rust_doc_test", "rust_test_suite")

# `os-random` matches what a Cargo workspace build resolves to: resolver-2 unifies
# features across the graph, and `deep_causality_physics` (via `physics_examples` and
# `chronometric_examples`) turns it on. Keeping Bazel on the same feature set is what
# makes the Lund hadronization kernels reachable from the example binaries.
rust_library(
    name = "deep_causality_rand",
    srcs = glob([
        "src/**",
    ]),
    aliases = aliases(),
    crate_features = [
        "os-random",
    ],
    crate_root = "src/lib.rs",
    lint_config = lint_config(),
    tags = [
        "random_number_utils",
    ],
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)

rust_doc(
    name = "doc",
    crate = ":deep_causality_rand",
    tags = ["doc"],
    visibility = ["//visibility:public"],
)

rust_doc_test(
    name = "doc_test",
    crate = ":deep_causality_rand",
    tags = ["doc-test"],
    visibility = ["//visibility:public"],
)

rust_test_suite(
    name = "errors",
    srcs = glob([
        "tests/errors/*_tests.rs",
    ]),
    tags = [
        "unit-test",
    ],
    visibility = ["//visibility:public"],
    deps = [
        # Crate to test
        ":deep_causality_rand",
    ] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

rust_test_suite(
    name = "types_dist",
