load("@crates//:defs.bzl", "aliases", "all_crate_deps", "lint_config")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rust//rust:defs.bzl", "rust_doc", "rust_doc_test", "rust_test_suite")

rust_library(
    name = "deep_causality_num",
    srcs = glob([
        "src/**",
    ]),
    aliases = aliases(),
    crate_features = [
        "std",
        "libm_math",
    ],  # List of features to enable
    crate_root = "src/lib.rs",
    lint_config = lint_config(),
    tags = [
        "numerical_utils",
    ],
    visibility = ["//visibility:public"],
    deps = [
        # `libm` is optional behind `libm_math`, which is not in Cargo's `default` set, so
        # all_crate_deps does not carry it. crate_features above enables the feature, so the
        # dependency has to be named.
        "@crates//:libm",
    ] + all_crate_deps(normal = True),
)

rust_doc(
    name = "doc",
    crate = ":deep_causality_num",
    crate_features = [
        "std",
        "libm_math",
    ],
    tags = ["doc"],
    visibility = ["//visibility:public"],
)

rust_doc_test(
    name = "doc_test",
    crate = ":deep_causality_num",
    crate_features = [
        "std",
        "libm_math",
    ],
    tags = ["doc-test"],
    visibility = ["//visibility:public"],
)

