load("@crates//:defs.bzl", "aliases", "all_crate_deps", "lint_config")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rust//rust:defs.bzl", "rust_doc", "rust_doc_test", "rust_test_suite")

rust_library(
    name = "deep_causality_linear",
    srcs = glob([
        "src/**",
    ]),
    aliases = aliases(),
    crate_features = [
        "std",
    ],
    crate_root = "src/lib.rs",
    lint_config = lint_config(),
    tags = [
        "linear",
        "math",
    ],
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)

rust_doc(
    name = "doc",
    crate = ":deep_causality_linear",
    tags = ["doc"],
    visibility = ["//visibility:public"],
)

rust_doc_test(
    name = "doc_test",
    crate = ":deep_causality_linear",
    tags = ["doc-test"],
    visibility = ["//visibility:public"],
)

rust_test_suite(
    name = "algorithms",
    srcs = glob([
        "tests/algorithms/*_tests.rs",
    ]),
    tags = [
        "unit-test",
    ],
    visibility = ["//visibility:public"],
    deps = [
        # Crate to test
        ":deep_causality_linear",
    ] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

