load("@crates//:defs.bzl", "aliases", "all_crate_deps", "lint_config")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")

rust_binary(
    name = "hyperlens_example",
    srcs = glob(["hyperlens/**/*.rs"]),
    crate_root = "hyperlens/main.rs",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(
        normal = True,
        # Cargo `[[example]]` targets link dev-dependencies.
        normal_dev = True,
    ),
)

rust_binary(
    name = "structural_health_monitor_example",
    srcs = glob(["structural_health_monitor/**/*.rs"]),
    crate_root = "structural_health_monitor/main.rs",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(
        normal = True,
        # Cargo `[[example]]` targets link dev-dependencies.
        normal_dev = True,
    ),
)
