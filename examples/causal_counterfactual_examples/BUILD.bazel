load("@crates//:defs.bzl", "aliases", "all_crate_deps", "lint_config")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")

rust_library(
    name = "causal_counterfactual_examples",
    srcs = glob(["src/**"]),
    aliases = aliases(),
    crate_root = "src/lib.rs",
    lint_config = lint_config(),
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)

rust_binary(
    name = "counterfactual_treatment_effect",
    srcs = glob(["counterfactual_treatment_effect/**/*.rs"]),
    crate_root = "counterfactual_treatment_effect/main.rs",
    visibility = ["//visibility:public"],
    deps = [
        # Cargo puts the package's own lib on an example's extern prelude.
        ":causal_counterfactual_examples",
    ] + all_crate_deps(
        normal = True,
        # Cargo `[[example]]` targets link dev-dependencies.
        normal_dev = True,
    ),
)

