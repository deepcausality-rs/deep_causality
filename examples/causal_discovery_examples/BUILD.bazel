load("@crates//:defs.bzl", "aliases", "all_crate_deps", "lint_config")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")

rust_library(
    name = "causal_discovery_examples",
    srcs = [
        "no_lib.rs",
        "shared/cdl_data.rs",
        "shared/paths.rs",
    ],
    aliases = aliases(),
    crate_root = "no_lib.rs",
    lint_config = lint_config(),
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)

rust_binary(
    name = "example_mrmr",
    srcs = glob(["algos/mrmr/**/*.rs"]),
    crate_root = "algos/mrmr/main.rs",
    visibility = ["//visibility:public"],
    deps = [
        # Cargo puts the package's own lib on an example's extern prelude.
        ":causal_discovery_examples",
    ] + all_crate_deps(
        normal = True,
        # Cargo `[[example]]` targets link dev-dependencies.
        normal_dev = True,
    ),
)

