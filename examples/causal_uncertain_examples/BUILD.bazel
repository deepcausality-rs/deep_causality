    visibility = ["//visibility:public"],
    deps = [
        "//deep_causality_core",
        "//deep_causality_haft",
        "//deep_causality_uncertain",
    ],
)

rust_binary(
    name = "clinical_trial",
    srcs = glob(["clinical_trial/**/*.rs"]),
    crate_root = "clinical_trial/main.rs",
    visibility = ["//visibility:public"],
    deps = [
        "//deep_causality_core",
        "//deep_causality_uncertain",
    ],
)
