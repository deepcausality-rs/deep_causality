load("@crates//:defs.bzl", "aliases", "all_crate_deps", "lint_config")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")

rust_binary(
    name = "csm_example",
    srcs = glob(["csm_basic/**/*.rs"]),
    crate_root = "csm_basic/main.rs",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(
        normal = True,
        # Cargo `[[example]]` targets link dev-dependencies.
        normal_dev = True,
    ),
)

