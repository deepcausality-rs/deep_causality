load("@crates//:defs.bzl", "aliases", "all_crate_deps", "lint_config")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")

rust_library(
    name = "chronometric_examples",
    srcs = glob(["src/**"]),
    aliases = aliases(),
    crate_root = "src/lib.rs",
    lint_config = lint_config(),
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)

rust_binary(
    name = "gm_recovery",
    srcs = glob(["gm_recovery/**/*.rs"]),
    crate_root = "gm_recovery/main.rs",
    visibility = ["//visibility:public"],
    deps = [
        # Cargo puts the package's own lib on an example's extern prelude.
        ":chronometric_examples",
    ] + all_crate_deps(
        normal = True,
        # Cargo `[[example]]` targets link dev-dependencies.
        normal_dev = True,
    ),
)

# The Galileo E14 products that `//deep_causality_utils/deep_causality_file:integration` parses.
# The files live in this package, so the filegroup that carries them into that test's runfiles is
# declared here.
filegroup(
    name = "gnss_e14_fixtures",
    srcs = [
        "data/gnss/gbm18770.clk",
        "data/gnss/gbm18770.sp3",
    ],
    visibility = ["//visibility:public"],
)
