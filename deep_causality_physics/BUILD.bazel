load("@crates//:defs.bzl", "aliases", "all_crate_deps", "lint_config")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rust//rust:defs.bzl", "rust_doc", "rust_doc_test", "rust_test_suite")

# `os-random` gates the Lund string-fragmentation kernels. A Cargo workspace build
# already enables it (resolver-2 unification via `physics_examples` and
# `chronometric_examples`), so Bazel carrying it keeps the two builds on the same
# feature set and makes those kernels reachable from the example binaries.
rust_library(
    name = "deep_causality_physics",
    srcs = glob([
        "src/**",
    ]),
    aliases = aliases(),
    crate_features = [
        "std",
        "alloc",
        "os-random",
    ],
    crate_root = "src/lib.rs",
    lint_config = lint_config(),
    tags = [
        "physics",
    ],
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)

rust_doc(
    name = "doc",
    crate = ":deep_causality_physics",
    crate_features = [
        "std",
        "alloc",
        "os-random",
    ],
    tags = ["doc"],
    visibility = ["//visibility:public"],
)

rust_doc_test(
    name = "doc_test",
    crate = ":deep_causality_physics",
    crate_features = [
        "std",
        "alloc",
        "os-random",
    ],
    tags = ["doc-test"],
    visibility = ["//visibility:public"],
)

# =============================================================================
# constants/* test suites
#
# The src tree is organized as src/constants/<type>/, so the tests mirror it
# at tests/constants/<type>/.
# =============================================================================

rust_test_suite(
    name = "constants",
    srcs = glob([
        "tests/constants/*_tests.rs",
    ]),
    crate_features = [
        "std",
        "alloc",
    ],
    tags = [
        "unit-test",
    ],
    visibility = ["//visibility:public"],
    deps = [
        # Crate to test
        ":deep_causality_physics",
    ] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

