load("@rules_rust//rust:defs.bzl", "rust_doc", "rust_doc_test", "rust_library")

# `os-random` gates the Lund string-fragmentation kernels. A Cargo workspace build
# already enables it (resolver-2 unification via `physics_examples` and
# `chronometric_examples`), so Bazel carrying it keeps the two builds on the same
# feature set and makes those kernels reachable from the example binaries.
rust_library(
    name = "deep_causality_physics",
    srcs = glob([
        "src/**",
    ]),
    crate_features = [
        "std",
        "alloc",
        "os-random",
    ],
    crate_root = "src/lib.rs",
    tags = [
        "physics",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//deep_causality_unified_math/deep_causality_algebra",
        "//deep_causality_unified_math/deep_causality_calculus",
        "//deep_causality_core",
        "//deep_causality_unified_math/deep_causality_fft",
        "//deep_causality_unified_math/deep_causality_haft",
        "//deep_causality_unified_math/deep_causality_metric",
        "//deep_causality_unified_math/deep_causality_multivector",
        "//deep_causality_unified_math/deep_causality_num",
        "//deep_causality_unified_math/deep_causality_num_complex",
        "//deep_causality_unified_math/deep_causality_num_dual",
        "//deep_causality_par",
        # `os-random` feature dep
        "//deep_causality_unified_math/deep_causality_rand",
        "//deep_causality_unified_math/deep_causality_linear",
        "//deep_causality_unified_math/deep_causality_tensor",
        "//deep_causality_unified_math/deep_causality_topology",
        "//deep_causality_unified_math/deep_causality_uncertain",
    ],
)

rust_doc(
    name = "doc",
    crate = ":deep_causality_physics",
    crate_features = [
        "std",
        "alloc",
        "os-random",
    ],
    tags = ["doc"],
    visibility = ["//visibility:public"],
)

rust_doc_test(
    name = "doc_test",
    crate = ":deep_causality_physics",
    crate_features = [
        "std",
        "alloc",
        "os-random",
    ],
    tags = ["doc-test"],
    visibility = ["//visibility:public"],
)
